// One level of the environment cube's mip chain: each texel is the mean of
// the four texels it covers one level up (src_index and dst_index are the
// two levels' storage slots; size is the destination's extent). Faces are
// filtered independently; the box filter is exact for the power-of-two
// cube sizes the renderer creates.
#version 460
#include "render_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant, scalar) uniform Push { NphRenderIblPush pc; };

void main()
{
    const uvec3 id = gl_GlobalInvocationID;
    if (id.x >= pc.size || id.y >= pc.size) {
        return;
    }
    const ivec3 s = ivec3(id.xy * 2u, id.z);
    vec4 sum = imageLoad(nph_images_2d_array[nonuniformEXT(pc.src_index)], s);
    sum += imageLoad(nph_images_2d_array[nonuniformEXT(pc.src_index)], s + ivec3(1, 0, 0));
    sum += imageLoad(nph_images_2d_array[nonuniformEXT(pc.src_index)], s + ivec3(0, 1, 0));
    sum += imageLoad(nph_images_2d_array[nonuniformEXT(pc.src_index)], s + ivec3(1, 1, 0));
    imageStore(nph_images_2d_array[nonuniformEXT(pc.dst_index)], ivec3(id), sum * 0.25);
}
