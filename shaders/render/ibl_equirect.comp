// Fills level 0 of the environment cube from an equirectangular
// (latitude-longitude) texture: u = 0.5 looks down -Z, u grows towards +X,
// v = 0 is straight up (render/renderer.h NphRenderEnvironmentDesc).
// params.x is the source level to sample, chosen on the CPU so the source
// is not undersampled.
#version 460
#include "render_common.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(push_constant, scalar) uniform Push { NphRenderIblPush pc; };

void main()
{
    const uvec3 id = gl_GlobalInvocationID;
    if (id.x >= pc.size || id.y >= pc.size) {
        return;
    }
    const vec2 st = (vec2(id.xy) + 0.5) / float(pc.size);
    const vec3 d = nph_cube_direction(id.z, st);
    const vec2 uv = vec2(0.5 + atan(d.x, -d.z) * (0.5 * NPH_INV_PI),
                         acos(clamp(d.y, -1.0, 1.0)) * NPH_INV_PI);
    const vec3 radiance = nph_sample_2d_lod(pc.src_index, pc.sampler_index, uv, pc.params.x).rgb;
    imageStore(nph_images_2d_array[nonuniformEXT(pc.dst_index)], ivec3(id),
               vec4(min(max(radiance, vec3(0.0)), vec3(NPH_RENDER_HALF_MAX)), 1.0));
}
