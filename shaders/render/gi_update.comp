// The radiance cache's update (docs/render.md "Global illumination";
// ADR-0039; gi_common.glsl): within a fixed budget of rays a frame, one
// invocation for each stride x stride block of the frame's pixels takes a
// random pixel of it, the surface the visibility buffer has there, and the
// cell of the cache holding it (claimed if new), traces one ray in a
// cosine-distributed direction from it (Malley's method), and adds what
// arrives along the ray, times pi, to the cell's sums: the irradiance's
// estimate (the cosine over the direction's density is pi). The resolve
// (gi_resolve.comp) blends the frame's sums into the cell.
//
// What arrives: on a miss, the environment's radiance (a blurred level of
// its cube, which changes the irradiance's estimate little and its noise a
// lot); on a hit, the surface's emission plus its diffuse reflection of the
// sun (shadowed by a second ray where the sun casts shadows) and of the
// cache's own irradiance at the hit, so each frame adds a bounce to what the
// cells hold (the environment's irradiance where the hit's cell has none
// yet). Point and spot lights do not bounce yet (ADR-0039). Each sample is
// added to its cell and to the cells of the next NPH_RENDER_GI_ABOVE levels
// around the same point, its parents, whose light the filter gives the cell
// where its own is thin (gi_filter.comp, ADR-0090, ADR-0091). Texture detail
// at a hit is read at the level the hit's cell resolves: a cell across over
// the triangle's texel size (Akenine-Möller et al., "Texture Level of
// Detail Strategies for Real-Time Ray Tracing", Ray Tracing Gems, 2019,
// with the cell as the cone's footprint).
//
// A ray that hits within NphRenderGiView.near counts nothing: that range is
// the ambient occlusion's (ao.c), which darkens the cache's irradiance for
// what lies near; the cell's mean is then over the directions open that
// far, so nothing is occluded twice and no ray reaches past a wall nearer
// than that.
//
// A voxel's pixel (render/voxel.h; ADR-0061) is the point and face the voxel
// resolve finds again, a cell's diagonal off the face as the resolve looks
// its cell up there (vis_voxel.glsl vis_voxel_surface): the ray leaves clear
// of the triangles the voxel stands for, which the rays trace. The update
// looks for voxels only where specialised to (k_voxels: the renderer holds a
// mesh with voxel levels, as for the resolve), so that a frame without them
// pays nothing for their search.
//
// Where the renderer has many lights (k_many; many_lights.c), each sample also takes
// one light from their tree, in proportion to what it may deliver here, and a shadow
// ray to it: its light beyond its near range, over the probability of choosing it,
// is an estimate of all their far fields' irradiance, which is added to the cell's
// with the ray's (two independent estimates of two terms, so their means add).
//
// arg0: the visibility buffer's bindless storage index.
#version 460
#extension GL_EXT_ray_query : require
#include "vis_common.glsl"
#include "vis_voxel.glsl"
#include "nph_bindless_int64.glsl"
#include "rt_common.glsl"
#include "rt_mask.glsl"
#include "gi_common.glsl"
#include "many_lights.glsl"
#include "gi_hit.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

// Whether the visibility buffer may hold voxel clusters' pixels (gi.c).
layout(constant_id = 0) const bool k_voxels = false;
// Whether this frame has many lights (many_lights.c).
layout(constant_id = 1) const bool k_many = false;

// The point of the visibility buffer's triangle `v` under the pixel at
// NDC `q`, camera relative, as the resolve rebuilds it (the same arithmetic,
// so the update keys the cell the shading looks up: a point rebuilt from
// depth through the inverse projection strays by more than a cell's
// rounding allows), and the triangle's normal facing the camera.
vec3 surface_point(VisViewRef view, uint64_t v, vec2 q, out vec3 n)
{
    const NphVisCluster cluster = VisClustersRef(view.v.clusters).c[vis_cluster(v)];
    const NphVisInstance inst = VisInstancesRef(view.v.instances).i[cluster.instance];
    const NphVisMesh mesh = VisMeshesRef(view.v.meshes).m[cluster.mesh];
    const uvec4 m = uvec4(cluster.vertex_offset, cluster.triangle_offset, cluster.counts, 0u);
    const uvec3 corners = vis_triangle_corners(mesh, m.y, vis_triangle(v));
    VisUintRef mlvx = VisUintRef(mesh.meshlet_vertices);
    const vec3 t =
        vis_relative_translation(inst.transform, view.v.camera_high.xyz, view.v.camera_low.xyz);
    const vec3 w0 =
        vis_transform_vector(inst.transform, vis_position(mesh, mlvx.v[m.x + corners.x])) + t;
    const vec3 w1 =
        vis_transform_vector(inst.transform, vis_position(mesh, mlvx.v[m.x + corners.y])) + t;
    const vec3 w2 =
        vis_transform_vector(inst.transform, vis_position(mesh, mlvx.v[m.x + corners.z])) + t;
    const VisBarycentrics bary =
        vis_barycentrics(view.v.view_proj * vec4(w0, 1.0), view.v.view_proj * vec4(w1, 1.0),
                         view.v.view_proj * vec4(w2, 1.0), q, 2.0 * view.v.viewport.zw);
    const vec3 x = mat3(w0, w1, w2) * bary.b;
    n = normalize(cross(w1 - w0, w2 - w0));
    n = dot(n, x) > 0.0 ? -n : n;
    return x;
}

// One sample of the many lights' far fields' irradiance at the camera-relative `x`,
// facing `n`, for `u` uniform in [0, 1): the chosen light's over its probability.
vec3 many_far_sample(VisViewRef view, ViewRef rview, vec3 x, vec3 n, float u)
{
    const NphRenderManyView m = ManyViewRef(rview.v.many).m;
    const vec3 at = x + m.to_origin.xyz;
    float pdf;
    const uint i = nph_many_sample(m, at, u, pdf);
    if (pdf <= 0.0) {
        return vec3(0.0);
    }
    const NphRenderManyLightData light = ManyLightsRef(m.records).l[i];
    const vec3 to_light = light.position.xyz - at;
    const float d2 = max(dot(to_light, to_light), 1e-8);
    const float share = nph_many_far_share(d2, light.position.w, light.color.w);
    const float inv_d = inversesqrt(d2);
    const vec3 l = to_light * inv_d;
    const float nol = dot(n, l);
    if (share <= 0.0 || nol <= 0.0) {
        return vec3(0.0);
    }
    const float distance = 1.0 / inv_d;
    const float lit =
        nph_shadow_ray_masked(view, rview.v.tlas, x + rview.v.tlas_offset.xyz, n, l, distance);
    return light.color.rgb * (share * nol * lit * inv_d * inv_d / pdf);
}

// One sample added to the sums of the cell in `slot`, if the frame has left it fewer than `most`.
void add_sample_within(GiViewRef g, uint slot, uvec3 fixed_e, uint fixed_far, uint most)
{
    GiSumsRef sums = GiSumsRef(g.g.sums);
    if (atomicAdd(sums.s[slot].w, 1u) >= most) {
        atomicAdd(sums.s[slot].w, 0xFFFFFFFFu); // full: not this one
        return;
    }
    if (fixed_e.x != 0u) {
        atomicAdd(sums.s[slot].x, fixed_e.x);
    }
    if (fixed_e.y != 0u) {
        atomicAdd(sums.s[slot].y, fixed_e.y);
    }
    if (fixed_e.z != 0u) {
        atomicAdd(sums.s[slot].z, fixed_e.z);
    }
    if (fixed_far != 0u) {
        atomicAdd(GiKeysRef(g.g.far_sums).k[slot], fixed_far);
    }
}

// One sample added to the sums of the cell in `slot`.
void add_sample(GiViewRef g, uint slot, uvec3 fixed_e, uint fixed_far)
{
    GiSumsRef sums = GiSumsRef(g.g.sums);
    if (fixed_e.x != 0u) {
        atomicAdd(sums.s[slot].x, fixed_e.x);
    }
    if (fixed_e.y != 0u) {
        atomicAdd(sums.s[slot].y, fixed_e.y);
    }
    if (fixed_e.z != 0u) {
        atomicAdd(sums.s[slot].z, fixed_e.z);
    }
    atomicAdd(sums.s[slot].w, 1u);
    if (fixed_far != 0u) {
        atomicAdd(GiKeysRef(g.g.far_sums).k[slot], fixed_far);
    }
}

void main()
{
    VisViewRef view = VisViewRef(pc.view);
    ViewRef rview = ViewRef(view.v.render_view);
    GiViewRef g = GiViewRef(rview.v.gi);
    const uvec2 block = gl_GlobalInvocationID.xy;
    const ivec2 size = ivec2(view.v.viewport.xy);
    const uint stride = g.g.stride;
    if (block.x >= g.g.rays_x || int(block.y * stride) >= size.y) {
        return;
    }
    const vec3 u0 = gi_random(uvec3(block, g.g.frame));
    const ivec2 p = min(ivec2(block * stride) + ivec2(u0.xy * float(stride)), size - 1);
    const uint64_t v = imageLoad(nph_u64images_2d[nonuniformEXT(pc.arg0)], p).x;
    if (v == 0ul) {
        return; // the background
    }

    // The pixel's point and its triangle's normal, or its voxel's.
    vec3 n;
    vec3 x;
    if (k_voxels &&
        (VisClustersRef(view.v.clusters).c[vis_cluster(v)].flags & NPH_VIS_CLUSTER_VOXELS) != 0u) {
        VisVoxelSurface vs;
        vis_voxel_surface(view, rview.v.inv_view_proj, v, p, vs);
        n = vs.face_normal;
        x = vs.position + vs.face_normal * vs.offset;
    } else {
        const vec2 q = (vec2(p) + 0.5) * view.v.viewport.zw * 2.0 - 1.0;
        x = surface_point(view, v, q, n);
    }
    const int level = gi_level(length(x));
    const uint slot = gi_claim_cell(g, gi_key_at(g, x, n, level));
    if (slot == GI_NONE) {
        atomicAdd(VisCountersRef(view.v.counters).c.gi_dropped, 1u);
        return; // its bucket is full: no sample
    }
    // Its cell's parent, the cell of the next level around the point, which takes the sample too
    // (ADR-0090): four cells' samples (a surface's), so it settles four times sooner, and it is
    // there with its light when the camera backs away and the surface takes that level's cells.
    const uint parent = level + 1 < NPH_RENDER_GI_LEVELS
                            ? gi_claim_cell(g, gi_key_at(g, x, n, level + 1))
                            : GI_NONE;

    // A cosine-distributed direction about n: a uniform point of the unit
    // disc lifted onto the hemisphere (Malley's method).
    const vec3 u1 = gi_random(uvec3(block.yx, g.g.frame ^ 0x9E3779B9u));
    const float r = sqrt(u1.x);
    const float phi = 2.0 * NPH_PI * u1.y;
    const float s = n.z >= 0.0 ? 1.0 : -1.0;
    const float a = -1.0 / (s + n.z);
    const float bb = n.x * n.y * a;
    const vec3 tangent = vec3(1.0 + s * n.x * n.x * a, s * bb, -s * n.x);
    const vec3 bitangent = vec3(bb, s + n.y * n.y * a, -n.y);
    const vec3 w = normalize(r * cos(phi) * tangent + r * sin(phi) * bitangent +
                             sqrt(max(1.0 - u1.x, 0.0)) * n);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, accelerationStructureEXT(rview.v.tlas), gl_RayFlagsNoneEXT, 0xFFu,
                          nph_offset_ray(x + rview.v.tlas_offset.xyz, n), 0.0, w, 1e30);
    NPH_RAY_TRAVERSE(view, rq)
    vec3 radiance;
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
        radiance = environment(rview, w);
    } else {
        if (rayQueryGetIntersectionTEXT(rq, true) < g.g.near) {
            return; // the ambient occlusion's range
        }
        const GiHit h = hit_surface(view, rview, g, rq, w, 0.0);
        // The light the hit receives is the cache's, where it holds the hit's cell. It may not:
        // no frame has seen the surface (ADR-0090). Taken for open to the whole sky then, as it
        // was, the unseen side of every room and archway lit what faced it: under a roof walled
        // on three sides, grey surfaces got eleven times their light. So the ray goes on from
        // the hit, a bounce further, for a sample of what the hit receives, and the sample is
        // the hit's cell's own as much as this ray's: it is added to the hit's cell, if it has
        // one, and to that cell's parent, made if need be, which the next ray to land there
        // finds with light (one sample alone, two chances taken in a row, left the shade it lit
        // wandering by a third from one tenth of a second to the next). A cell found whose last
        // sample is NPH_RENDER_GI_HIT_AGE frames old is one the camera's own samples do not keep
        // up: the ray goes on from it too. What the second bounce meets unseen is taken to
        // receive what the first does, or what the ray's own surface does, as the last frame
        // left their cells.
        vec3 arriving = h.cached;
        if (!h.known || h.age >= uint(NPH_RENDER_GI_HIT_AGE)) {
            const vec3 u2 = gi_random(uvec3(block, g.g.frame ^ 0x3C6EF372u));
            const float r2 = sqrt(u2.x);
            const float phi2 = 2.0 * NPH_PI * u2.y;
            const float s2 = h.face.z >= 0.0 ? 1.0 : -1.0;
            const float a2 = -1.0 / (s2 + h.face.z);
            const float b2 = h.face.x * h.face.y * a2;
            const vec3 t2 = vec3(1.0 + s2 * h.face.x * h.face.x * a2, s2 * b2, -s2 * h.face.x);
            const vec3 bt2 = vec3(b2, s2 + h.face.y * h.face.y * a2, -h.face.y);
            const vec3 w2 = normalize(r2 * cos(phi2) * t2 + r2 * sin(phi2) * bt2 +
                                      sqrt(max(1.0 - u2.x, 0.0)) * h.face);
            rayQueryEXT rq2;
            rayQueryInitializeEXT(rq2, accelerationStructureEXT(rview.v.tlas), gl_RayFlagsNoneEXT,
                                  0xFFu, nph_offset_ray(h.x + rview.v.tlas_offset.xyz, h.face), 0.0,
                                  w2, 1e30);
            NPH_RAY_TRAVERSE(view, rq2)
            vec3 sample2;
            if (rayQueryGetIntersectionTypeEXT(rq2, true) == gl_RayQueryCommittedIntersectionNoneEXT) {
                sample2 = environment(rview, w2) * NPH_PI;
            } else {
                const GiHit h2 = hit_surface(view, rview, g, rq2, w2, 0.0);
                vec3 beyond = h2.cached;
                if (!h2.known) {
                    beyond = h.cached;
                    if (!h.known) {
                        // (The ray's own cell's, or in its first frame its parent's, which was
                        // the surface's own cell if the camera has just come nearer.)
                        uvec4 here = GiCellsRef(g.g.cells).c[slot];
                        if (gi_word_count(here.w) == 0u && parent != GI_NONE) {
                            here = GiCellsRef(g.g.cells).c[parent];
                        }
                        beyond = uintBitsToFloat(here.xyz); // nothing, where that has none either
                    }
                }
                sample2 = (h2.direct + h2.albedo * NPH_INV_PI * beyond) * NPH_PI;
            }
            const uvec3 fixed2 = uvec3(
                min(sample2 * rview.v.exposure, vec3(NPH_RENDER_GI_SAMPLE_MAX)) * g.g.sum_scale + 0.5);
            if (h.slot != GI_NONE) {
                add_sample(g, h.slot, fixed2, 0u);
            }
            // (A new one in the first half of its bucket only: the cells of what the rays meet
            // are many, all around the camera, and must not crowd the frame's own out of the
            // table.)
            const uint above = h.level + 1 < NPH_RENDER_GI_LEVELS
                                   ? gi_claim_cell_within(g, gi_key_at(g, h.x, h.face, h.level + 1),
                                                          uint(NPH_RENDER_GI_BUCKET) / 2u)
                                   : GI_NONE;
            if (above != GI_NONE) {
                add_sample(g, above, fixed2, 0u);
            }
            if (!h.known) {
                arriving = sample2;
            }
        }
        radiance = h.direct + h.albedo * NPH_INV_PI * arriving;
    }

    vec3 irradiance = radiance * NPH_PI;
    vec3 far = vec3(0.0);
    if (k_many) {
        const float u2 = gi_random(uvec3(block, g.g.frame ^ 0x7F4A7C15u)).x;
        far = many_far_sample(view, rview, x, n, u2);
        irradiance += far;
    }

    // The estimate, pre-exposed, in fixed point; the far fields' alone (their luminance), for the
    // cell's share of them (ADR-0078).
    const vec3 e = min(irradiance * rview.v.exposure, vec3(NPH_RENDER_GI_SAMPLE_MAX));
    const uvec3 fixed_e = uvec3(e * g.g.sum_scale + 0.5);
    uint fixed_far = 0u;
    if (k_many) {
        const float far_e = min(dot(far, vec3(0.2126, 0.7152, 0.0722)) * rview.v.exposure,
                                NPH_RENDER_GI_SAMPLE_MAX);
        fixed_far = uint(far_e * g.g.sum_scale + 0.5);
    }
    add_sample(g, slot, fixed_e, fixed_far);
    if (parent != GI_NONE) {
        add_sample(g, parent, fixed_e, fixed_far);
    }
    // And the cells of the levels above those around the point (ADR-0091): each twice as wide as
    // the one under it, with four times the samples a frame, so that where the frame has just
    // come to a surface some cell around each point knows its light within a frame or two, and
    // the cells under it begin with that (gi_filter.comp). Their sums hold a frame's samples
    // only so far: the first NPH_RENDER_GI_ABOVE_SAMPLES to arrive (a sample is at most
    // NPH_RENDER_GI_SAMPLE_MAX).
    for (int up = 2; up <= NPH_RENDER_GI_ABOVE && level + up < NPH_RENDER_GI_LEVELS; ++up) {
        const uint wider = gi_claim_cell(g, gi_key_at(g, x, n, level + up));
        if (wider != GI_NONE) {
            add_sample_within(g, wider, fixed_e, fixed_far, uint(NPH_RENDER_GI_ABOVE_SAMPLES));
        }
    }
}
