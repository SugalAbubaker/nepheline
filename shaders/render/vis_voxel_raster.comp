// SPDX-License-Identifier: Apache-2.0
// The visibility buffer's voxel raster (docs/render.md "Voxels"; ADR-0061):
// one workgroup per voxel cluster of the phase's voxel list, which the
// meshlet cull fills.
//
// The voxels are splatted: each projects its footprint's box (a capsule's
// widened by its radius, within its cell) to the pixels whose centres it may
// cover, and each of those pixels' rays is tested against that voxel alone
// (vis_voxel.glsl vis_voxel_hit). A box's corners lie on its brick's grid of
// 32nds of a cell, so its centre and half-extents go to clip space as steps
// along that grid, the same for the whole cluster (its bricks share a cell
// size). Its projection lies within (rx + |xc / wc| rw) / (wc - rw) of its
// centre's in x, and likewise in y, where rx and rw are the half-extents'
// reach in clip x and w; that is widened by a 64th of a pixel against
// rounding. A subgroup's voxels pool their pixels, so that the rays' tests
// fill its lanes whichever voxels cover pixels: at the first voxel levels a
// cell is about a pixel and a foliage footprint a fraction of its cell, so
// about one voxel in five covers a pixel's centre.
//
// A pixel's ray runs from the camera through its point on the near plane,
// in the instance's space. Under reverse-Z with an infinite far plane a hit
// at parameter t along it lies at depth exactly 1 / t (vis_voxel_depth),
// and the nearest voxel takes the atomic max of (depth, cluster, brick) the
// triangles' rasters write. The voxel resolve and the radiance cache's
// update find that voxel again among the cells next to the depth's point
// (vis_voxel_find), with the same arithmetic.
//
// A voxel wholly behind the near plane covers nothing. One whose box reaches
// behind the camera's plane takes the whole target (the levels of detail
// never pick a voxel cluster that close: its cell would cover many pixels; a
// frozen culling camera can).
//
// arg0 is the visibility buffer's storage index.
#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#include "vis_voxel.glsl"
#include "nph_bindless_int64.glsl"

layout(local_size_x = 64) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

#define BRICKS 32u // NPH_RENDER_VOXEL_CLUSTER_BRICKS

// Shared arrays as arrays of structs of their own (docs/build.md "Shaders").
// A brick, and its lowest corner in clip space.
struct VisVoxelBrickShared {
    uvec4 b0;
    uvec4 b1;
    vec4 clip;
};
// A voxel's pixels: their rectangle's corner (x | y << 16) and size (w | h
// << 16), the subgroup's pixels before them, and the voxel (its brick | its
// cell << 5 | its index in the cluster << 11).
struct VisVoxelSplat {
    uvec4 v;
};
shared VisVoxelBrickShared s_brick[BRICKS];
shared VisVoxelSplat s_splat[64];

// The position of the set bit of rank n (from 0) in the mask (m0, m1).
uint nth_bit(uint m0, uint m1, uint n)
{
    uint at = 0u;
    uint m = m0;
    uint c = bitCount(m0);
    if (n >= c) {
        n -= c;
        m = m1;
        at = 32u;
    }
    for (uint w = 16u; w >= 2u; w >>= 1u) {
        c = bitCount(m & ((1u << w) - 1u));
        if (n >= c) {
            n -= c;
            m >>= w;
            at += w;
        }
    }
    return at + (n >= (m & 1u) ? 1u : 0u);
}

void main()
{
    VisViewRef view = VisViewRef(pc.view);
    const uint kind = uint(NPH_VIS_RASTER_VOXEL);
    const uint wg = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    // The same for the whole workgroup, so no invocation misses a barrier.
    if (wg >= VisCountersRef(view.v.counters).c.raster_count[pc.phase][kind]) {
        return;
    }
    const uint g = VisUintRef(view.v.raster_lists[pc.phase][kind]).v[wg];
    const NphVisCluster cluster = VisClustersRef(view.v.clusters).c[g];
    const NphVisInstance inst = VisInstancesRef(view.v.instances).i[cluster.instance];
    const NphVisMesh mesh = VisMeshesRef(view.v.meshes).m[inst.mesh];
    const uvec4 m = VisMeshletsRef(mesh.meshlets).m[cluster.meshlet];
    const uint brick_count = min(m.z >> 16u, BRICKS);
    const vec3 t =
        vis_relative_translation(inst.transform, view.v.camera_high.xyz, view.v.camera_low.xyz);
    const vec2 viewport = view.v.viewport.xy;
    const mat4 vp = view.v.view_proj;
    const uint i = gl_LocalInvocationIndex;
    // A voxel cluster's meshlet: its first brick, its record (render/voxel.h
    // "The compact form").
    const VisVoxelCluster vc = vis_voxel_cluster(mesh.voxel_clusters, m.y);
    VisPackedBricksRef bricks = VisPackedBricksRef(mesh.voxel_bricks);
    VisVoxelWordsRef run = vis_voxel_run(mesh.voxels, vc);
    // The cluster's cell, and a 32nd of it along each axis in clip space.
    const float h = vc.h;
    const float step = h / VIS_VOXEL_BOX_STEPS;
    const vec4 ax = vp * vec4(vis_transform_vector(inst.transform, vec3(step, 0.0, 0.0)), 0.0);
    const vec4 ay = vp * vec4(vis_transform_vector(inst.transform, vec3(0.0, step, 0.0)), 0.0);
    const vec4 az = vp * vec4(vis_transform_vector(inst.transform, vec3(0.0, 0.0, step)), 0.0);
    if (i < brick_count) {
        uvec4 b0;
        uvec4 b1;
        vis_voxel_brick(bricks, m.x + i, vc, b0, b1);
        s_brick[i].b0 = b0;
        s_brick[i].b1 = b1;
        s_brick[i].clip =
            vp * vec4(vis_transform_vector(inst.transform, uintBitsToFloat(b0.xyz)) + t, 1.0);
    }
    barrier();
    // A cluster's voxels follow one another in its bricks' order, their ranks
    // from the first brick's (checked when a mesh is made: 0), so voxel k of
    // the cluster is rank first + k.
    const uint first = s_brick[0].b1.z;
    const uvec4 last = s_brick[brick_count - 1u].b1;
    const uint total = last.z - first + bitCount(last.x) + bitCount(last.y);
    const float near = view.v.projection.z;
    const mat4 inv_view_proj = ViewRef(view.v.render_view).v.inv_view_proj;
    const vec2 inv_size = view.v.viewport.zw;
    // The instance's part of every pixel's ray, once.
    const mat3 inv = vis_voxel_inverse_linear(inst.transform);
    const vec3 o = vis_voxel_ray_origin(inv, t);
    const uint lane = gl_SubgroupInvocationID;
    const uint size = gl_SubgroupSize;
    const uint own = gl_SubgroupID * size; // the subgroup's entries of s_splat
    for (uint base = own; base < total; base += 64u) {
        const uint k = base + lane;
        uint pixels = 0u;
        uvec4 splat = uvec4(0u);
        if (k < total) {
            // The brick holding voxel k: its first voxel at or before k, the
            // next brick's after.
            uint lo = 0u;
            uint hi = brick_count;
            while (hi - lo > 1u) {
                const uint mid = (lo + hi) >> 1u;
                if (s_brick[mid].b1.z - first <= k) {
                    lo = mid;
                } else {
                    hi = mid;
                }
            }
            const uvec4 b1 = s_brick[lo].b1;
            const uint bit = nth_bit(b1.x, b1.y, first + k - b1.z);
            // Its material's capsule byte, its box.
            const uvec2 fp = vis_voxel_load_footprint(run, vc.stride, first + k).zw;
            // The footprint's box in 32nds of a cell from the brick's corner.
            const uvec3 cell = uvec3(bit & 3u, (bit >> 2u) & 3u, bit >> 4u) * 32u;
            vec3 box_lo;
            vec3 box_hi;
            for (uint a = 0u; a < 3u; ++a) {
                box_lo[a] = float(cell[a] + ((fp.y >> (5u * a)) & 31u));
                box_hi[a] = float(cell[a] + ((fp.y >> (15u + 5u * a)) & 31u) + 1u);
            }
            if ((fp.y >> 30u) == VIS_VOXEL_SHAPE_CAPSULE) {
                const float reach = vis_voxel_radius((fp.x >> 26u) & 63u) * VIS_VOXEL_BOX_STEPS;
                box_lo = max(box_lo - reach, vec3(cell));
                box_hi = min(box_hi + reach, vec3(cell + 32u));
            }
            const vec3 mid3 = 0.5 * (box_lo + box_hi);
            const vec3 half3 = 0.5 * (box_hi - box_lo);
            const vec4 c = s_brick[lo].clip + mid3.x * ax + mid3.y * ay + mid3.z * az;
            const vec4 e = half3.x * abs(ax) + half3.y * abs(ay) + half3.z * abs(az);
            // Rays start on the near plane, where clip w is its distance.
            if (c.w + e.w >= 0.999 * near) {
                vec2 pmin = vec2(0.0);
                vec2 pmax = viewport;
                const float w_min = c.w - e.w;
                if (w_min > 0.0) {
                    const vec2 q = c.xy / c.w;
                    const vec2 reach = (e.xy + abs(q) * e.w) / w_min;
                    pmin = ((q - reach) * 0.5 + 0.5) * viewport;
                    pmax = ((q + reach) * 0.5 + 0.5) * viewport;
                }
                // The centres x + 1/2 within [pmin, pmax], held to the target
                // before the conversion, which overflows past it.
                const vec2 a = clamp(ceil(pmin - 0.5 - 1.0 / 64.0), vec2(0.0), viewport);
                const vec2 b = clamp(floor(pmax - 0.5 + 1.0 / 64.0), vec2(-1.0), viewport - 1.0);
                const ivec2 n = max(ivec2(b) - ivec2(a) + 1, ivec2(0));
                pixels = uint(n.x) * uint(n.y);
                splat.xy = uvec2(uint(a.x) | (uint(a.y) << 16u), uint(n.x) | (uint(n.y) << 16u));
            }
            splat.w = lo | (bit << 5u) | (k << 11u);
        }
        splat.z = subgroupExclusiveAdd(pixels);
        const uint pairs = subgroupAdd(pixels);
        s_splat[own + lane].v = splat;
        subgroupBarrier();
        for (uint j = lane; j < pairs; j += size) {
            // The voxel whose pixels hold pair j: the last with no more
            // pixels before it than j.
            uint lo = 0u;
            uint hi = size;
            while (hi - lo > 1u) {
                const uint mid = (lo + hi) >> 1u;
                if (s_splat[own + mid].v.z <= j) {
                    lo = mid;
                } else {
                    hi = mid;
                }
            }
            const uvec4 sp = s_splat[own + lo].v;
            const uint w = sp.y & 0xFFFFu;
            const uint local = j - sp.z;
            const ivec2 pixel = ivec2((sp.x & 0xFFFFu) + local % w, (sp.x >> 16u) + local / w);
            const uint brick = sp.w & 31u;
            vec3 world_dir;
            const vec3 d =
                vis_voxel_ray_dir(inv_view_proj, inv, vis_voxel_ndc(pixel, inv_size), world_dir);
            const VisVoxelRay r = vis_voxel_brick_ray(uintBitsToFloat(s_brick[brick].b0.xyz), o, d);
            float th;
            uint face;
            if (vis_voxel_hit(vis_voxel_load_footprint(run, vc.stride, first + (sp.w >> 11u)),
                              (sp.w >> 5u) & 63u, h, r, 1.0, 3.402823466e38, th, face)) {
                imageAtomicMax(nph_u64images_2d[nonuniformEXT(pc.arg0)], pixel,
                               vis_pack(vis_voxel_depth(th), g, brick));
            }
        }
        subgroupBarrier();
    }
}
