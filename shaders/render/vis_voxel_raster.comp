// SPDX-License-Identifier: Apache-2.0
// The visibility buffer's voxel raster (docs/render.md "Voxels"; ADR-0061):
// a subgroup per voxel cluster of the phase's voxel list, which the meshlet
// cull fills, two subgroups of k_lanes a workgroup (one where k_pairs is off:
// a device with NPH_GPU_QUIRK_SUBGROUP_BARRIER_WAITS_FOR_WORKGROUP). The
// pipeline asks its subgroups' size, all full
// (NphGpuComputePipelineDesc.subgroup_size; vis.c takes the device's nearest
// 32), so each subgroup takes its cluster from its records to its last flush
// and waits for no other: most clusters are small (the city's cells' proxies
// average 85 voxels, a third of them 32 or fewer), and a cluster shared by a
// workgroup's subgroups left one of them a batch or none after loading the
// cluster's records and computing its transforms as the other did.
//
// The voxels are splatted: each projects its footprint's box (a capsule's
// widened by its radius, within its cell) to the pixels whose centres it may
// cover, and each of those pixels' rays is tested against that voxel alone
// (vis_voxel.glsl vis_voxel_hit). A box's corners lie on its brick's grid of
// 32nds of a cell, so its centre and half-extents go to clip space as steps
// along that grid, the same for the whole cluster (its bricks share a cell
// size). Its projection lies within (rx + |xc / wc| rw) / (wc - rw) of its
// centre's in x, and likewise in y, where rx and rw are the half-extents'
// reach in clip x and w; that is widened by a 64th of a pixel against
// rounding.
//
// At the first voxel levels a cell is about a pixel and a foliage footprint
// a fraction of its cell, so few voxels cover a pixel's centre (on the
// city's rooftop 28 %, with 1.16 pixels each), and a batch of a subgroup's
// voxels has pixels for about a third of its lanes. So a subgroup queues the
// voxels of its batches that cover pixels, and tests their pixels' rays when
// another batch might not fit and at the end, the pixels spread over its
// lanes.
//
// The triangles' rasters run before this pass, and the voxels' depths only
// rise in the atomic maximum, so a voxel whose box lies wholly behind what a
// pixel holds already cannot take it: that pixel's test is skipped, and a
// voxel of one pixel (most of those that cover any) joins no queue. The box's
// nearest depth is near / w at its least clip w, raised by a 4096th against
// the rounding of w and of a hit's 1 / t. A read may be older than another
// workgroup's latest write, never larger, so it only skips less. So too a
// brick, before its voxels are taken (brick_hidden): where what the pixels
// hold lies in front of its box's nearest depth at every centre the box's
// projection may hold, or that holds none, the brick keeps none of its
// voxels, and the subgroup takes those of the bricks kept, each brick's
// first from a prefix sum of their counts (on the city's rooftop it drops
// 35 % of phase 0's voxels and 95 % of phase 1's). Not in a cluster two
// subgroups share: each would read the buffer at its own time, and the two
// must take the same voxels in turn. The skips change only the work:
// NPH_RENDER_VIS_NO_VOXEL_SKIP turns them off, which a test compares against.
//
// A pixel's ray runs from the camera through its point on the near plane,
// in the instance's space. Under reverse-Z with an infinite far plane a hit
// at parameter t along it lies at depth exactly 1 / t (vis_voxel_depth),
// and the nearest voxel takes the atomic max of (depth, cluster, brick) the
// triangles' rasters write. The voxel resolve and the radiance cache's
// update find that voxel again among the cells next to the depth's point
// (vis_voxel_find), with the same arithmetic.
//
// A voxel wholly behind the near plane covers nothing. One whose box reaches
// behind the camera's plane takes the whole target (the levels of detail
// never pick a voxel cluster that close: its cell would cover many pixels; a
// frozen culling camera can).
//
// arg0 is the visibility buffer's storage index.
#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "vis_voxel.glsl"
#include "nph_bindless_int64.glsl"

// Two subgroups of k_lanes, or one without k_pairs: vis.c sets them, the
// local size k_lanes times the subgroups. A phase of few clusters leaves most
// of the GPU idle, and a cluster is drawn sooner by both of a workgroup's
// subgroups, each with its own copy of the bricks, in alternate batches: the
// pipeline with k_share takes those phases, a cluster a workgroup, and
// vis_args.comp gives it or the other the phase's workgroups.
layout(local_size_x_id = 0) in;
layout(constant_id = 1) const uint k_lanes = 32u;
layout(constant_id = 2) const bool k_pairs = true;
layout(constant_id = 3) const bool k_share = false;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

#define BRICKS 32u // NPH_RENDER_VOXEL_CLUSTER_BRICKS

// Shared arrays as arrays of structs of their own (docs/build.md "Shaders").
// A brick, its lowest corner in clip space, and of the voxels the subgroup
// takes the first that is its and how many are (none where it is hidden:
// brick_hidden).
struct VisVoxelBrickShared {
    uvec4 b0;
    uvec4 b1;
    vec4 clip;
    uvec2 kept;
};
// A voxel's pixels: their rectangle's corner (x | y << 16) and size (w | h
// << 16), the pixels before them in its subgroup's queue, and the voxel (its
// brick | its cell << 5 | its index in the cluster << 11).
struct VisVoxelSplat {
    uvec4 v;
};
// A queued voxel's depth bound (voxel_splat).
struct VisVoxelNear {
    uint depth;
};
// Each subgroup's cluster's bricks, from gl_SubgroupID * BRICKS.
shared VisVoxelBrickShared s_brick[2u * BRICKS];
// The subgroups' queues, room for two batches of a subgroup's voxels each.
shared VisVoxelSplat s_splat[4u * k_lanes];
shared VisVoxelNear s_near[4u * k_lanes];

// The depth a pixel of the visibility buffer holds, as bits (positive
// floats order as their bits).
uint held_depth(ivec2 pixel)
{
    return uint(imageLoad(nph_u64images_2d[nonuniformEXT(pc.arg0)], pixel).x >> 32ul);
}

// Whether no voxel of a brick could take a pixel: its lowest corner is
// `corner` in clip space, `ax`, `ay`, `az` a 32nd of a cell along each axis.
// Its box is its 4 x 4 x 4 cells, which hold every voxel's footprint, and a
// pixel's ray meets the footprint only where the box's projection (the hull
// of its corners', all in front of the camera) holds the pixel's centre, as
// does the rectangle about it. So the brick is hidden where that rectangle
// holds no centre, or where the visibility buffer holds more than the box's
// nearest depth at each it holds: the triangles' rasters have run (and in
// phase 1 all of phase 0), and depths only rise. A rectangle of more than
// BRICK_TEST_PIXELS centres, or a box reaching behind the camera, is not
// tested.
#define BRICK_TEST_PIXELS 64
bool brick_hidden(vec4 corner, vec4 ax, vec4 ay, vec4 az, float near, vec2 viewport)
{
    vec2 lo = vec2(3.402823466e38);
    vec2 hi = vec2(-3.402823466e38);
    float w_min = 3.402823466e38;
    for (uint i = 0u; i < 8u; ++i) {
        const vec4 q = corner + float(i & 1u) * 128.0 * ax + float((i >> 1u) & 1u) * 128.0 * ay +
                       float(i >> 2u) * 128.0 * az;
        if (!(q.w > 0.0)) {
            return false;
        }
        const vec2 s = (q.xy / q.w * 0.5 + 0.5) * viewport;
        lo = min(lo, s);
        hi = max(hi, s);
        w_min = min(w_min, q.w);
    }
    // The centres x + 1/2 within the hull's rectangle, widened by a 64th of a
    // pixel and held to the target as a voxel's are (voxel_splat).
    const ivec2 p0 = ivec2(clamp(ceil(lo - 0.5 - 1.0 / 64.0), vec2(0.0), viewport));
    const ivec2 p1 = ivec2(clamp(floor(hi - 0.5 + 1.0 / 64.0), vec2(-1.0), viewport - 1.0));
    if (any(greaterThan(p0, p1))) {
        return true; // off the target, or between centres
    }
    if ((p1.x - p0.x + 1) * (p1.y - p0.y + 1) > BRICK_TEST_PIXELS) {
        return false;
    }
    // As a voxel's bound (voxel_splat): near / w at the least w, raised by a
    // 4096th against the rounding of w and of a hit's 1 / t.
    const uint near_depth = floatBitsToUint(near / w_min * (1.0 + 1.0 / 4096.0));
    // The centres four at a time, their loads issued together (the last
    // repeated past the rectangle's end), until one holds less. Centre i is
    // (i % w, i / w) from the corner: i / w as floor((i + 1/2) / w), whose
    // fraction lies at least 1 / (2 w) from a whole number, far beyond the
    // rounding.
    const uint w = uint(p1.x - p0.x + 1);
    const uint last = w * uint(p1.y - p0.y + 1) - 1u;
    const float inv_w = 1.0 / float(w);
    for (uint i = 0u; i <= last; i += 4u) {
        uint least = 0xFFFFFFFFu;
        for (uint j = 0u; j < 4u; ++j) {
            const uint c = min(i + j, last);
            const uint y = uint((float(c) + 0.5) * inv_w);
            least = min(least, held_depth(p0 + ivec2(c - y * w, y)));
        }
        if (!(near_depth < least)) {
            return false;
        }
    }
    return true;
}

// The position of the set bit of rank n (from 0) in the mask (m0, m1).
uint nth_bit(uint m0, uint m1, uint n)
{
    uint at = 0u;
    uint m = m0;
    uint c = bitCount(m0);
    if (n >= c) {
        n -= c;
        m = m1;
        at = 32u;
    }
    for (uint w = 16u; w >= 2u; w >>= 1u) {
        c = bitCount(m & ((1u << w) - 1u));
        if (n >= c) {
            n -= c;
            m >>= w;
            at += w;
        }
    }
    return at + (n >= (m & 1u) ? 1u : 0u);
}

// Kept voxel k of the cluster, whose bricks are s_brick's `brick_count` from
// `bricks0` (the kept voxels: those of the bricks not hidden, in order, from
// each brick's kept.x): the pixels whose centres its box may cover, their
// count (none for a voxel of one pixel behind what that pixel holds, where
// `skip`), and in `splat` their rectangle and the voxel (VisVoxelSplat,
// without the pixels before them). The voxel's rank is first plus its index
// in the cluster. `ax`, `ay`, `az` are a 32nd of the cluster's cell along each
// axis in clip space. `near_depth` is the depth of the box's nearest point,
// the most any of its hits can have, as bits.
uint voxel_splat(uint k, uint first, uint bricks0, uint brick_count, VisVoxelWordsRef run,
                 uint stride, vec4 ax, vec4 ay, vec4 az, float near, vec2 viewport, bool skip,
                 out uvec4 splat, out uint near_depth)
{
    splat = uvec4(0u);
    near_depth = 0x7F800000u; // +inf
    // The brick holding kept voxel k: the last whose first kept voxel is at
    // or before k, in five halvings (BRICKS at most), so that the search
    // unrolls. A hidden brick keeps none, and starts where the next does,
    // which the search takes instead.
    uint lo = 0u;
    for (uint step = BRICKS / 2u; step > 0u; step >>= 1u) {
        const uint mid = lo + step;
        if (mid < brick_count && s_brick[bricks0 + mid].kept.x <= k) {
            lo = mid;
        }
    }
    const uvec4 b1 = s_brick[bricks0 + lo].b1;
    const uint in_brick = k - s_brick[bricks0 + lo].kept.x;
    const uint bit = nth_bit(b1.x, b1.y, in_brick);
    // Its index in the cluster: its rank from the first.
    const uint index = b1.z - first + in_brick;
    splat.w = lo | (bit << 5u) | (index << 11u);
    // Its material's capsule byte, its box.
    const uvec2 fp = vis_voxel_load_footprint(run, stride, first + index).zw;
    // The footprint's box in 32nds of a cell from the brick's corner.
    const uvec3 cell = uvec3(bit & 3u, (bit >> 2u) & 3u, bit >> 4u) * 32u;
    vec3 box_lo;
    vec3 box_hi;
    for (uint a = 0u; a < 3u; ++a) {
        box_lo[a] = float(cell[a] + ((fp.y >> (5u * a)) & 31u));
        box_hi[a] = float(cell[a] + ((fp.y >> (15u + 5u * a)) & 31u) + 1u);
    }
    if ((fp.y >> 30u) == VIS_VOXEL_SHAPE_CAPSULE) {
        const float reach = vis_voxel_radius((fp.x >> 26u) & 63u) * VIS_VOXEL_BOX_STEPS;
        box_lo = max(box_lo - reach, vec3(cell));
        box_hi = min(box_hi + reach, vec3(cell + 32u));
    }
    const vec3 mid3 = 0.5 * (box_lo + box_hi);
    const vec3 half3 = 0.5 * (box_hi - box_lo);
    const vec4 c = s_brick[bricks0 + lo].clip + mid3.x * ax + mid3.y * ay + mid3.z * az;
    const vec4 e = half3.x * abs(ax) + half3.y * abs(ay) + half3.z * abs(az);
    // Rays start on the near plane, where clip w is its distance.
    if (c.w + e.w < 0.999 * near) {
        return 0u;
    }
    vec2 pmin = vec2(0.0);
    vec2 pmax = viewport;
    const float w_min = c.w - e.w;
    if (w_min > 0.0) {
        const vec2 q = c.xy / c.w;
        const vec2 reach = (e.xy + abs(q) * e.w) / w_min;
        pmin = ((q - reach) * 0.5 + 0.5) * viewport;
        pmax = ((q + reach) * 0.5 + 0.5) * viewport;
        // Depth is near / w (reverse-Z, an infinite far plane).
        near_depth = floatBitsToUint(near / w_min * (1.0 + 1.0 / 4096.0));
    }
    // The centres x + 1/2 within [pmin, pmax], held to the target before the
    // conversion, which overflows past it.
    const vec2 a = clamp(ceil(pmin - 0.5 - 1.0 / 64.0), vec2(0.0), viewport);
    const vec2 b = clamp(floor(pmax - 0.5 + 1.0 / 64.0), vec2(-1.0), viewport - 1.0);
    const ivec2 n = max(ivec2(b) - ivec2(a) + 1, ivec2(0));
    splat.xy = uvec2(uint(a.x) | (uint(a.y) << 16u), uint(n.x) | (uint(n.y) << 16u));
    if (skip && n.x == 1 && n.y == 1 && near_depth < held_depth(ivec2(a))) {
        return 0u;
    }
    return uint(n.x) * uint(n.y);
}

// Cluster g of the phase's voxel list, by the calling subgroup, alone or as
// the `place`th of `sharing` that take its batches in turn: its bricks in
// s_brick from gl_SubgroupID * BRICKS, its queue in s_splat and s_near from
// gl_SubgroupID * 2 * k_lanes.
void raster_cluster(VisViewRef view, uint g, uint place, uint sharing)
{
    const uint lane = gl_SubgroupInvocationID;
    const uint bricks0 = gl_SubgroupID * BRICKS;
    const uint queue = gl_SubgroupID * 2u * k_lanes;
    const NphVisCluster cluster = VisClustersRef(view.v.clusters).c[g];
    const NphVisInstance inst = VisInstancesRef(view.v.instances).i[cluster.instance];
    const NphVisMesh mesh = VisMeshesRef(view.v.meshes).m[inst.mesh];
    const uvec4 m = VisMeshletsRef(mesh.meshlets).m[cluster.meshlet];
    const uint brick_count = min(m.z >> 16u, BRICKS);
    const vec3 t =
        vis_relative_translation(inst.transform, view.v.camera_high.xyz, view.v.camera_low.xyz);
    const vec2 viewport = view.v.viewport.xy;
    const mat4 vp = view.v.view_proj;
    // A voxel cluster's meshlet: its first brick, its record (render/voxel.h
    // "The compact form").
    const VisVoxelCluster vc = vis_voxel_cluster(mesh.voxel_clusters, m.y);
    VisPackedBricksRef bricks = VisPackedBricksRef(mesh.voxel_bricks);
    VisVoxelWordsRef run = vis_voxel_run(mesh.voxels, vc);
    // The cluster's cell, and a 32nd of it along each axis in clip space.
    const float h = vc.h;
    const float step = h / VIS_VOXEL_BOX_STEPS;
    const vec4 ax = vp * vec4(vis_transform_vector(inst.transform, vec3(step, 0.0, 0.0)), 0.0);
    const vec4 ay = vp * vec4(vis_transform_vector(inst.transform, vec3(0.0, step, 0.0)), 0.0);
    const vec4 az = vp * vec4(vis_transform_vector(inst.transform, vec3(0.0, 0.0, step)), 0.0);
    const float near = view.v.projection.z;
    const bool skip = (view.v.flags & uint(NPH_VIS_VIEW_VOXEL_SKIP)) != 0u;
    // A brick hidden behind what the visibility buffer holds keeps none of
    // its voxels. Not where two subgroups share the cluster: each would read
    // the buffer at its own time, and the two must take the same voxels in
    // turn.
    const bool cull = skip && sharing == 1u;
    uint hidden = 0u; // the lane's bricks found hidden
    for (uint b = lane; b < brick_count; b += k_lanes) {
        uvec4 b0;
        uvec4 b1;
        vis_voxel_brick(bricks, m.x + b, vc, b0, b1);
        const vec4 clip =
            vp * vec4(vis_transform_vector(inst.transform, uintBitsToFloat(b0.xyz)) + t, 1.0);
        s_brick[bricks0 + b].b0 = b0;
        s_brick[bricks0 + b].b1 = b1;
        s_brick[bricks0 + b].clip = clip;
        const bool gone = cull && brick_hidden(clip, ax, ay, az, near, viewport);
        s_brick[bricks0 + b].kept.y = gone ? 0u : bitCount(b1.x) + bitCount(b1.y);
        hidden += gone ? 1u : 0u;
    }
    VIS_ADD(VisCountersRef(view.v.counters).c.voxel_bricks_hidden, hidden);
    // Each brick's first kept voxel, a chunk of the subgroup's lanes at a
    // time (a lane reads the counts it wrote).
    uint total = 0u;
    for (uint c0 = 0u; c0 < brick_count; c0 += k_lanes) {
        const uint b = c0 + lane;
        const uint n = b < brick_count ? s_brick[bricks0 + b].kept.y : 0u;
        const uint before = subgroupExclusiveAdd(n);
        if (b < brick_count) {
            s_brick[bricks0 + b].kept.x = total + before;
        }
        total += subgroupAdd(n);
    }
    subgroupBarrier(); // the subgroup's bricks, for its lanes alone
    // A cluster's voxels follow one another in its bricks' order, their ranks
    // from the first brick's (checked when a mesh is made: 0), so voxel i of
    // the cluster is rank first + i.
    const uint first = s_brick[bricks0].b1.z;
    const mat4 inv_view_proj = ViewRef(view.v.render_view).v.inv_view_proj;
    const vec2 inv_size = view.v.viewport.zw;
    // The instance's part of every pixel's ray, once.
    const mat3 inv = vis_voxel_inverse_linear(inst.transform);
    const vec3 o = vis_voxel_ray_origin(inv, t);
    uint queued = 0u;  // the queue's voxels, the same in the whole subgroup
    uint pending = 0u; // and their pixels
    for (uint base = place * k_lanes;; base += sharing * k_lanes) {
        const bool more = base < total;
        if (more) {
            const uint k = base + lane;
            uvec4 splat = uvec4(0u);
            uint near_depth = 0u;
            const uint pixels =
                k < total ? voxel_splat(k, first, bricks0, brick_count, run, vc.stride, ax, ay,
                                        az, near, viewport, skip, splat, near_depth)
                          : 0u;
            // The voxels with pixels join the queue.
            const uvec4 ballot = subgroupBallot(pixels != 0u);
            const uint before = subgroupExclusiveAdd(pixels);
            if (pixels != 0u) {
                const uint at = queue + queued + subgroupBallotExclusiveBitCount(ballot);
                splat.z = pending + before;
                s_splat[at].v = splat;
                s_near[at].depth = near_depth;
            }
            queued += subgroupBallotBitCount(ballot);
            pending += subgroupAdd(pixels);
            if (queued <= k_lanes) {
                continue; // another batch fits
            }
        }
        subgroupBarrier();
        for (uint j = lane; j < pending; j += k_lanes) {
            // The voxel whose pixels hold pixel j of the queue's: the last
            // with no more pixels before it than j, in halvings from k_lanes
            // (a queue holds two batches, 2 * k_lanes voxels at most).
            uint lo = 0u;
            for (uint step = k_lanes; step > 0u; step >>= 1u) {
                const uint mid = lo + step;
                if (mid < queued && s_splat[queue + mid].v.z <= j) {
                    lo = mid;
                }
            }
            const uvec4 sp = s_splat[queue + lo].v;
            const uint w = sp.y & 0xFFFFu;
            const uint local = j - sp.z;
            const ivec2 pixel = ivec2((sp.x & 0xFFFFu) + local % w, (sp.x >> 16u) + local / w);
            if (skip && s_near[queue + lo].depth < held_depth(pixel)) {
                continue; // behind what the pixel holds
            }
            const uint brick = sp.w & 31u;
            vec3 world_dir;
            const vec3 d =
                vis_voxel_ray_dir(inv_view_proj, inv, vis_voxel_ndc(pixel, inv_size), world_dir);
            const VisVoxelRay r =
                vis_voxel_brick_ray(uintBitsToFloat(s_brick[bricks0 + brick].b0.xyz), o, d);
            float th;
            uint face;
            if (vis_voxel_hit(vis_voxel_load_footprint(run, vc.stride, first + (sp.w >> 11u)),
                              (sp.w >> 5u) & 63u, h, r, 1.0, 3.402823466e38, th, face)) {
                imageAtomicMax(nph_u64images_2d[nonuniformEXT(pc.arg0)], pixel,
                               vis_pack(vis_voxel_depth(th), g, brick));
            }
        }
        subgroupBarrier();
        if (!more) {
            break;
        }
        queued = 0u;
        pending = 0u;
    }
}

void main()
{
    VisViewRef view = VisViewRef(pc.view);
    const uint kind = uint(NPH_VIS_RASTER_VOXEL);
    const uint wg = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    // The workgroup's two clusters, a subgroup each (the second of the last
    // workgroup, of an odd count, has none), or its one, shared with k_share.
    const uint c = k_pairs && !k_share ? 2u * wg + gl_SubgroupID : wg;
    if (c >= VisCountersRef(view.v.counters).c.raster_count[pc.phase][kind]) {
        return;
    }
    raster_cluster(view, VisUintRef(view.v.raster_lists[pc.phase][kind]).v[c],
                   k_share ? gl_SubgroupID : 0u, k_share ? 2u : 1u);
}
