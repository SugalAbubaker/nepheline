// What smooth surfaces reflect (docs/adr/0077-reflections.md): after the resolve, each pixel that
// left its mirror direction and tint looks up its reflection cell (gi_common.glsl), falls back on
// the sky as far as the scene lets it through, adds what it finds to the HDR image, and clears what
// it left. The resolve holds no more than a store for this: it runs at its register limit.
//
// mode: the target's width | height << 16; phase: the occlusion's bindless sampled index
// (NPH_VIS_NO_AO: none); arg0: the visibility buffer's bindless storage index; arg1: the HDR image's;
// arg2: what the pixels left; arg3, arg4: the address of the tiles' list. A workgroup a tile.
#version 460
#include "vis_common.glsl"
#include "nph_bindless_int64.glsl"
#include "gi_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

// Whether the HDR target is B10G11R11, whose coarse steps are dithered.
layout(constant_id = 0) const bool k_dither = false;

void main()
{
    const uint listed = GiKeysRef(uint64_t(pc.arg3) | (uint64_t(pc.arg4) << 32ul)).k[gl_WorkGroupID.x];
    const ivec2 p = ivec2(uvec2(listed & 0xFFFFu, listed >> 16u) * 8u + gl_LocalInvocationID.xy);
    if (p.x >= int(pc.mode & 0xFFFFu) || p.y >= int(pc.mode >> 16u)) {
        return;
    }
    const uvec2 w = imageLoad(nph_uimages_2d[pc.arg2], p).xy;
    if (w.y == 0u) {
        return;
    }
    imageStore(nph_uimages_2d[pc.arg2], p, uvec4(0u));
    VisViewRef view = VisViewRef(pc.view);
    ViewRef rview = ViewRef(view.v.render_view);
    GiViewRef g = GiViewRef(rview.v.gi);
    // The point from its depth: a cell is a dozen pixels across.
    const float depth = vis_depth(imageLoad(nph_u64images_2d[nonuniformEXT(pc.arg0)], p).x);
    const vec2 q = (vec2(p) + 0.5) * view.v.viewport.zw * 2.0 - 1.0;
    const vec4 h = rview.v.inv_view_proj * vec4(q, depth, 1.0);
    const vec3 x = h.xyz / h.w;
    const uint rough = (w.x >> 24u) & 15u;
    const float noise = nph_gradient_noise(vec2(p) + 5.588238 * float(g.g.frame & 63u));
    const vec2 u = g.g.jitter != 0u ? vec2(noise, fract(noise * 1.618034 + 0.5)) : vec2(0.5);
    const vec4 cell = gi_reflect_cell(g, x, uvec2(w.x & 0xFFFu, (w.x >> 12u) & 0xFFFu), rough, u);
    const float weight = cell.w * clamp(float(15u - rough) * 0.25, 0.0, 1.0);
    // Where its cell gives out, the sky along its direction, no brighter than what the irradiance
    // cell around it has gathered; and that where only the roughness fades it, of a pixel near
    // those that take that cell's light alone.
    vec3 fallback = vec3(0.0);
    if (weight < 1.0) {
        const vec3 mirror = gi_reflect_direction(w.x);
        const vec3 n = normalize(normalize(mirror) + normalize(-x));
        const uint around_slot = gi_find(g, gi_key(g, x, n));
        const vec4 around = around_slot == GI_NONE ? vec4(0.0) : gi_cell(g, around_slot);
        fallback = around.rgb * (NPH_INV_PI * rview.v.exposure);
        if (cell.w < 1.0 && (rview.v.flags & NPH_RENDER_VIEW_IBL) != 0u) {
            const float roughness = float(rough) * (NPH_RENDER_REFLECT_MAX_ROUGHNESS / 15.0);
            vec3 sky = textureLod(samplerCube(nph_textures_cube[nonuniformEXT(rview.v.specular_index)],
                                              nph_samplers[nonuniformEXT(rview.v.clamp_sampler)]),
                                  mirror, roughness * rview.v.specular_max_lod)
                           .rgb *
                       (rview.v.ibl_intensity * rview.v.exposure);
            const float bright = dot(sky, vec3(0.2126, 0.7152, 0.0722));
            const float scene = dot(fallback, vec3(0.2126, 0.7152, 0.0722));
            fallback = sky * (around.w > 0.0 && bright > scene ? mix(1.0, scene / bright, around.w) : 1.0);
        }
    }
    // What it shows of that: its energy from the lookup table (a smooth surface's energy term is
    // 1), and the screen's occlusion, near what the cells' rays see too little of.
    const vec3 v = normalize(-x);
    const vec3 mirror_d = normalize(gi_reflect_direction(w.x));
    const float nov = clamp(dot(mirror_d, normalize(mirror_d + v)), 1e-4, 1.0);
    const float roughness_t = float(rough) * (NPH_RENDER_REFLECT_MAX_ROUGHNESS / 15.0);
    const vec2 dfg = textureLod(sampler2D(nph_textures_2d[nonuniformEXT(rview.v.brdf_lut_index)],
                                          nph_samplers[nonuniformEXT(rview.v.clamp_sampler)]),
                                vec2(nov, roughness_t), 0.0).xy;
    const float ao = pc.phase != NPH_VIS_NO_AO ? abs(texelFetch(nph_textures_2d[pc.phase], p, 0).r) : 1.0;
    const float a = roughness_t * roughness_t;
    const float seen = clamp(pow(nov + ao, exp2(-16.0 * a - 1.0)) - 1.0 + ao, 0.0, 1.0);
    const vec3 base = gi_reflect_specular(w.y);
    const vec3 tint = (base * dfg.x + (vec3(1.0) - base) * dfg.y) * seen;
    vec3 color = imageLoad(nph_images_2d[nonuniformEXT(pc.arg1)], p).rgb +
                 tint * mix(fallback, cell.rgb * rview.v.exposure, weight);
    color = min(color, vec3(NPH_RENDER_HALF_MAX));
    if (k_dither) {
        color = nph_dither_b10g11r11(color, nph_gradient_noise(vec2(p)));
    }
    imageStore(nph_images_2d[nonuniformEXT(pc.arg1)], p, vec4(color, 1.0));
}
