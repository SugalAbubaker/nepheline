// The voxels' tests, ray by ray, for the render tests
// (VoxelGpu.the_voxel_tests_match_their_cpu_twin). Each ray's first voxel in
// its brick is the nearest of its voxels' hits (vis_voxel_hit), as the
// raster takes it, compared there with render/voxel.h's
// nph_render_voxel_trace; and the resolve's search from that hit's depth
// (vis_voxel_find), which must meet the same voxel at the same t and face
// bit for bit (face | 512). Not used by the renderer.
#version 460
#include "vis_voxel.glsl"

layout(local_size_x = 64) in;
layout(push_constant, scalar) uniform Push { NphVisVoxelPush pc; };

NPH_BUFFER_REF(VisVoxelCasesRef) { NphVisVoxelCase c[]; };
NPH_BUFFER_REF(VisVoxelResultsRef) { NphVisVoxelResult r[]; };

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    const NphVisVoxelCase c = VisVoxelCasesRef(pc.cases).c[i];
    // One brick a voxel cluster: the case's brick names its cluster too.
    const VisVoxelCluster vc = vis_voxel_cluster(pc.clusters, c.brick);
    VisVoxelWordsRef run = vis_voxel_run(pc.voxels, vc);
    uvec4 b0;
    uvec4 b1;
    vis_voxel_brick(VisPackedBricksRef(pc.bricks), c.brick, vc, b0, b1);
    const float h = uintBitsToFloat(b0.w);
    const VisVoxelRay r = vis_voxel_brick_ray(uintBitsToFloat(b0.xyz), c.origin.xyz, c.dir.xyz);
    VisVoxelHit hit;
    hit.t = 0.0;
    hit.voxel = 0u;
    hit.cell = 0u;
    hit.face = 0u;
    bool found = false;
    for (uint bit = 0u; bit < 64u; ++bit) {
        const uint word = bit < 32u ? b1.x : b1.y;
        if (((word >> (bit & 31u)) & 1u) == 0u) {
            continue;
        }
        const uint index = b1.z + vis_voxel_rank(b1.x, b1.y, bit);
        float t;
        uint face;
        if (vis_voxel_hit(vis_voxel_load(run, vc.stride, vc.cluster_look, index), bit, h, r,
                          c.origin.w, c.dir.w, t, face) &&
            (!found || t < hit.t)) {
            found = true;
            hit.t = t;
            hit.voxel = index;
            hit.cell = bit;
            hit.face = face;
        }
    }
    NphVisVoxelResult res;
    res.t = hit.t;
    res.voxel = hit.voxel;
    res.cell = hit.cell;
    res.face = 0u;
    if (found) {
        res.face = hit.face | 256u;
        // The depth the raster writes, and the search from it.
        const float depth = vis_voxel_depth(hit.t);
        VisVoxelHit again;
        if (vis_voxel_find(b0, b1, run, vc.stride, c.origin.xyz, c.dir.xyz, depth, again) &&
            again.t == hit.t && again.voxel == hit.voxel && again.face == hit.face) {
            res.face |= 512u;
        }
    }
    VisVoxelResultsRef(pc.results).r[i] = res;
}
