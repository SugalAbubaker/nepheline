// The shading tiles' bins (docs/render.md "Shading"): an invocation per
// tile appends it, as x | y << 16, to the list of its bin by the class
// vis_hzb.comp gave it: NPH_VIS_BIN_SKY for tiles of background alone,
// NPH_VIS_BIN_LIT for the others. The resolve then runs once per bin,
// specialised for it, so a bin's pipeline holds only the code its tiles
// need (the tile classification of Garawany, "Deferred Lighting in
// Uncharted 4", SIGGRAPH 2016).
#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "vis_common.glsl"

layout(local_size_x = 64) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

void main()
{
    VisViewRef view = VisViewRef(pc.view);
    const uint i = gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 64u + gl_GlobalInvocationID.x;
    const uint tiles_x = view.v.shade_tiles_x;
    bool sky = false;
    bool lit = false;
    uint tile = 0u;
    if (i < tiles_x * view.v.shade_tiles_y) {
        lit = (VisUintRef(view.v.tile_class).v[i] & uint(NPH_VIS_TILE_GEOMETRY)) != 0u ||
              (view.v.flags & uint(NPH_VIS_VIEW_TILE_BINS)) == 0u;
        sky = !lit;
        tile = (i % tiles_x) | ((i / tiles_x) << 16u);
    }
    VisCountersRef counters = VisCountersRef(view.v.counters);
    uint sky_at;
    uint lit_at;
    VIS_RESERVE(counters.c.tiles[NPH_VIS_BIN_SKY], sky ? 1u : 0u, sky_at);
    VIS_RESERVE(counters.c.tiles[NPH_VIS_BIN_LIT], lit ? 1u : 0u, lit_at);
    if (sky) {
        VisUintRef(view.v.tile_lists[NPH_VIS_BIN_SKY]).v[sky_at] = tile;
    }
    if (lit) {
        VisUintRef(view.v.tile_lists[NPH_VIS_BIN_LIT]).v[lit_at] = tile;
    }
}
