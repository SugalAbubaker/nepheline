// SPDX-License-Identifier: Apache-2.0
// Instance culling (docs/render.md "The production path"), the first level
// of the GPU-driven pipeline (Haar & Aaltonen, "GPU-Driven Rendering
// Pipelines", SIGGRAPH 2015; Wihlidal, "Optimizing the Graphics Pipeline
// with Compute", GDC 2016). Each invocation takes one instance and tests
// its mesh's bounding sphere:
//
//   phase 0 (every instance slot): against the frustum, then against the
//     previous frame's hierarchical depth, seen from the previous camera
//     with the instance's previous transform (that is the view the HZB
//     was built from). Instances that pass hand their meshlets to phase 0's
//     meshlet cull; occluded ones are deferred to phase 1.
//   phase 1 (the deferred instances): against the HZB built from what
//     phase 0 drew, with the current camera and transform; instances now
//     visible hand their meshlets to phase 1's meshlet cull, after the
//     meshlets phase 0 deferred in the same list.
//
// This is the two-phase occlusion culling of Karis et al., "Nanite: A Deep
// Dive" (SIGGRAPH 2021): phase 0's test against last frame's depth may be
// wrong for this frame, but anything it misses is retested in phase 1
// against depth this frame drew, which only holds surfaces really in front,
// so nothing visible is lost.
//
// An instance whose mesh has levels of detail hands its hierarchy's root to
// the first of the hierarchy's steps instead (vis_cull_nodes.comp), which
// find the clusters of the level each part of it needs; one so near that
// every part needs level 0, and any in a view without the levels
// (NPH_VIS_VIEW_LOD unset), hands on level 0's meshlets as any mesh's.
//
// The instances of a world partition's cell give way to the cell's proxy
// where it is drawn, and the proxy to them elsewhere (vis_cell_proxied;
// ADR-0062): both decide first, from the cell's record and the view alike.
//
// The meshlets go out as (instance, meshlet) work items, one per meshlet,
// so the meshlet cull runs an invocation per meshlet with every lane busy,
// whatever the meshes' sizes. The subgroup writes its instances' items
// together: one atomic for the subgroup's total, then each invocation
// writes an equal share, finding each item's instance by a binary search
// over the subgroup's prefix sums, so a thousand-meshlet instance beside
// one-meshlet ones costs every lane the same.
#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#include "vis_common.glsl"

layout(local_size_x = 64) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

void main()
{
    VisViewRef view = VisViewRef(pc.view);
    VisCountersRef counters = VisCountersRef(view.v.counters);
    const uint phase = pc.phase;
    const uint id = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 64u +
                    gl_LocalInvocationIndex;

    uint slot = 0xFFFFFFFFu;
    if (phase == 0u) {
        if (id < view.v.instance_count) {
            slot = id;
        }
    } else if (id < min(counters.c.deferred_instances, view.v.max_deferred)) {
        slot = VisUintRef(view.v.deferred_instances).v[id];
    }

    bool defer = false;
    bool culled_frustum = false;
    bool culled_occlusion = false;
    bool cell_proxied = false;     // a cell's proxy, drawn for its distance (statistics)
    bool instance_proxied = false; // an instance its cell's proxy stands in for (statistics)
    uint meshlets = 0u;            // handed to the meshlet cull
    bool root = false;             // hands its hierarchy's root to the hierarchy's steps
    if (slot != 0xFFFFFFFFu) {
        const NphVisInstance inst = VisInstancesRef(view.v.instances).i[slot];
        bool shown = (inst.flags & NPH_VIS_INSTANCE_VISIBLE) != 0u;
        const uint cell = inst.flags >> NPH_VIS_INSTANCE_CELL_SHIFT;
        if (shown && cell != 0u) {
            const bool proxy = (inst.flags & NPH_VIS_INSTANCE_PROXY) != 0u;
            const bool proxied = vis_cell_proxied(view, cell);
            shown = proxied == proxy;
            cell_proxied = phase == 0u && proxy && proxied &&
                           (inst.flags & NPH_VIS_INSTANCE_PROXY_COUNTED) != 0u;
            instance_proxied = phase == 0u && !proxy && proxied;
        }
        if (shown) {
            const NphVisMesh mesh = VisMeshesRef(view.v.meshes).m[inst.mesh];
            const vec3 t = vis_relative_translation(inst.transform, view.v.camera_high.xyz,
                                                    view.v.camera_low.xyz);
            const vec3 c = vis_transform_vector(inst.transform, mesh.sphere.xyz) + t;
            const float r = mesh.sphere.w * vis_max_scale(inst.transform);
            const bool occlusion = (view.v.flags & NPH_VIS_VIEW_OCCLUSION) != 0u;
            if (phase == 0u) {
                if (!vis_sphere_in_frustum(view, c, r)) {
                    culled_frustum = true;
                } else if (occlusion && (view.v.flags & NPH_VIS_VIEW_HZB_VALID) != 0u) {
                    // As the previous frame saw it.
                    const NphVisTransform pt = VisTransformsRef(view.v.prev_transforms).t[slot];
                    const vec3 ptr = vis_relative_translation(pt, view.v.prev_camera_high.xyz,
                                                              view.v.prev_camera_low.xyz);
                    const vec3 pc_world = vis_transform_vector(pt, mesh.sphere.xyz) + ptr;
                    const vec3 pv = (view.v.prev_view * vec4(pc_world, 1.0)).xyz;
                    const float pr = mesh.sphere.w * vis_max_scale(pt);
                    vec4 rect;
                    float depth;
                    defer = vis_project_sphere(pv, pr, view.v.prev_projection, rect, depth) &&
                            vis_hzb_occluded(view, rect + view.v.jitter.zwzw, depth);
                }
            } else if (occlusion) {
                const vec3 cv = (view.v.view * vec4(c, 1.0)).xyz;
                vec4 rect;
                float depth;
                culled_occlusion = vis_project_sphere(cv, r, view.v.projection, rect, depth) &&
                                   vis_hzb_occluded(view, rect + view.v.jitter.xyxy, depth);
            }
            if (!culled_frustum && !defer && !culled_occlusion) {
                // A mesh with levels walks its hierarchy, unless even the
                // finest of the groups that consume level 0 is too coarse
                // from the far side of its sphere: then the cut is level 0
                // whole, as the mesh's own meshlets.
                root = mesh.lod_nodes != 0ul && (view.v.flags & NPH_VIS_VIEW_LOD) != 0u &&
                       !vis_lod_surely_too_coarse(view, inst.transform, t,
                                                  vis_max_scale(inst.transform), mesh.sphere,
                                                  mesh.lod_level0_error);
                meshlets = root ? 0u : mesh.meshlet_count;
            }
        }
    }

    VIS_COUNT(counters.c.instances_culled_frustum, culled_frustum);
    VIS_COUNT(counters.c.instances_culled_occlusion, culled_occlusion);
    VIS_COUNT(counters.c.cells_proxied, cell_proxied);
    VIS_COUNT(counters.c.instances_proxied, instance_proxied);
    if (phase == 0u) {
        uint d;
        VIS_RESERVE(counters.c.deferred_instances, defer ? 1u : 0u, d);
        if (defer) {
            if (d < view.v.max_deferred) {
                VisUintRef(view.v.deferred_instances).v[d] = slot;
            } else {
                atomicOr(counters.c.overflow, uint(NPH_VIS_OVERFLOW_DEFERRED));
            }
        }
    }

    // The hierarchy's root, into its first queue (each phase starts from an
    // empty one), and the first step's workgroups raised to take it.
    uint q;
    VIS_RESERVE(counters.c.lod_nodes[0], root ? 1u : 0u, q);
    if (root) {
        if (q < view.v.max_lod_nodes) {
            VisUvec2Ref(view.v.lod_queue[0]).v[q] = uvec2(slot, 0u);
        } else {
            atomicOr(counters.c.overflow, uint(NPH_VIS_OVERFLOW_LOD_NODES));
        }
    }
    const uint roots = subgroupMax(root ? min(q + 1u, view.v.max_lod_nodes) : 0u);
    if (roots != 0u && subgroupElect()) {
        atomicMax(VisArgsRef(view.v.args).a.lod_node_args[0][0],
                  (roots + uint(NPH_VIS_LOD_ITEMS) - 1u) / uint(NPH_VIS_LOD_ITEMS));
    }

    // The subgroup's meshlets as work items (see the file comment).
    const uint inclusive = subgroupInclusiveAdd(meshlets);
    const uint first = inclusive - meshlets;
    const uint total = subgroupAdd(meshlets);
    uint base = 0u;
    if (total != 0u && subgroupElect()) {
        if (phase == 0u) {
            base = atomicAdd(counters.c.cull_meshlets, total);
        } else {
            base = atomicAdd(counters.c.deferred_meshlets, total);
        }
    }
    base = subgroupBroadcastFirst(base);
    const uint capacity = phase == 0u ? view.v.max_cull_meshlets : view.v.max_deferred;
    VisUvec2Ref list = VisUvec2Ref(phase == 0u ? view.v.cull_meshlets : view.v.deferred_meshlets);
    const uint rounds = (total + gl_SubgroupSize - 1u) / gl_SubgroupSize;
    for (uint round = 0u; round < rounds; ++round) {
        const uint k = round * gl_SubgroupSize + gl_SubgroupInvocationID;
        // The owner is the first invocation whose inclusive prefix passes k.
        // Every invocation takes part in each shuffle (the loops' bounds
        // are the subgroup's), as shuffles require.
        uint owner = 0u;
        for (uint step = gl_SubgroupSize >> 1u; step != 0u; step >>= 1u) {
            const uint v = subgroupShuffle(inclusive, owner + step - 1u);
            if (v <= k) {
                owner += step;
            }
        }
        const uint owner_slot = subgroupShuffle(slot, owner);
        const uint owner_first = subgroupShuffle(first, owner);
        if (k < total) {
            const uint index = base + k;
            if (index < capacity) {
                list.v[index] = uvec2(owner_slot, k - owner_first);
            } else {
                atomicOr(counters.c.overflow, phase == 0u ? uint(NPH_VIS_OVERFLOW_MESHLETS)
                                                          : uint(NPH_VIS_OVERFLOW_DEFERRED));
            }
        }
    }
}
