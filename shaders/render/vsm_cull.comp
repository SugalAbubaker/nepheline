// SPDX-License-Identifier: Apache-2.0
// The virtual shadow map's casters (docs/render.md "Shadows";
// shaders/shared/nph_vsm.h): what the pages drawn this frame need drawn
// into them, in two modes.
//
//   INSTANCES: an invocation per instance slot and level with pages to
//     draw (the dispatch's z indexes those levels, NphVsmArgs.levels). A visible
//     instance whose bounding sphere spans a page to draw of the level, and
//     does not lie wholly beyond the level's far plane, hands its meshlets
//     on as (instance, meshlet, level) items, a subgroup's together as in
//     vis_cull_instances.comp; a mesh with levels of detail drawn at its
//     cut hands its hierarchy's root to the walk (vsm_cull_nodes.comp)
//     instead, which hands on the cut's clusters near the pages to draw. A
//     world partition's cell is drawn into a level as its proxy or as its
//     instances (vsm_cell_proxied; ADR-0062).
//   MESHLETS: an invocation per item: the meshlet's bounding sphere against
//     the level's pages to draw, one draw (instance, meshlet, entry) per
//     page it spans. Devices without mesh shaders also get the draw as an
//     indexed indirect command (NphVisDraw) over the index pool, as the
//     visibility buffer's indirect raster does. A voxel cluster's draws go
//     to a list of their own (NphVsmView.voxel_draws), which the voxel
//     casters' splat takes (vsm_voxel_splat.comp; ADR-0061).
//   CELLS_TEST, CELLS_EXPAND: where cells come first (ADR-0064), before the
//     instance cull, an invocation per cell slot and level with pages to
//     draw (z): a cell whose box (its sphere) touches none of the level's
//     pages to draw lists nothing, its members' bounds lying in its box; one
//     that does lists its proxy's run where the level draws it as its proxy
//     (vsm_cell_proxied, the instance cull's own test), else its members',
//     as a (cell, level) pair with its items' places reserved. Then a
//     workgroup per listed pair writes its run's slots as (instance, level)
//     items, which the instance cull takes, and then the instances of no
//     cell at each level with pages to draw, in place of every slot.
//   CELLS: an invocation per cell slot (NphVisPush.arg0 of them) and level
//     (z): a cell drawn into the level as its proxy whose box touches a
//     page this frame's pixels need asks for the level of its proxy the
//     map level takes (ADR-0063 stage 3), every frame, whether the page is
//     drawn or kept: a kept page still holds the level it was drawn with,
//     and a request only where pages are drawn would come and go with them
//     (a level given up for want of a request redraws its pages, which ask
//     for it again).
//
// Casters are drawn from both sides and from every direction: no normal
// cone culling, since a meshlet facing away from the light shadows all the
// same. A mesh with levels of detail (docs/render.md "Levels of detail") is
// drawn at the cut of vsm_lod_threshold for the instance and the level, the
// same every frame, so a page drawn stays right.
#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_vote : require
#include "vis_common.glsl"
#include "vsm_common.glsl"
#include "vsm_cells.glsl"

layout(local_size_x = 64) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

// Whether the casters may hold voxel clusters (vsm.c: while the renderer
// holds a mesh with voxel levels), so that a frame without them pays
// nothing for their routing.
layout(constant_id = 0) const bool k_voxels = false;


void cull_instances(VisViewRef view, VsmViewRef r)
{
    VsmCountersRef counters = VsmCountersRef(r.v.counters);
    const uint id = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 64u +
                    gl_LocalInvocationIndex;
    // Where cells come first, the cells' items, each its instance and level,
    // then the instances of no cell at each level with pages to draw; else
    // every instance slot at the level the dispatch's z names.
    uint slot = 0xFFFFFFFFu;
    int level = 0;
    if (view.v.cell_slots != 0u) {
        const uint listed = min(counters.c.cell_work, r.v.max_cell_work);
        if (id < listed) {
            const uint item = VisUintRef(r.v.cell_work).v[id];
            slot = item & 0x0FFFFFFFu;
            level = int(item >> 28u);
        } else if (view.v.loose_count != 0u) {
            const uint k = id - listed;
            const uint z = k / view.v.loose_count;
            if (z < VsmArgsRef(r.v.args).a.cell_test_args[2]) {
                slot = VisUintRef(view.v.cell_members)
                           .v[view.v.loose_first + (k - z * view.v.loose_count)];
                level = int(VsmArgsRef(r.v.args).a.levels[z]);
            }
        }
    } else {
        level = int(VsmArgsRef(r.v.args).a.levels[gl_WorkGroupID.z]);
        slot = id < view.v.instance_count ? id : 0xFFFFFFFFu;
    }
    uint meshlets = 0u;
    bool walk = false; // its hierarchy's root to the walk, in place of its meshlets
    if (slot != 0xFFFFFFFFu) {
        const NphVisInstance inst = VisInstancesRef(view.v.instances).i[slot];
        bool shown = (inst.flags & NPH_VIS_INSTANCE_VISIBLE) != 0u;
        const uint cell = inst.flags >> NPH_VIS_INSTANCE_CELL_SHIFT;
        if (shown && cell != 0u) {
            shown = vsm_cell_proxied(view, r, level, cell) ==
                    ((inst.flags & NPH_VIS_INSTANCE_PROXY) != 0u);
        }
        if (shown) {
            const NphVisMesh mesh = VisMeshesRef(view.v.meshes).m[inst.mesh];
            const vec3 t = vis_relative_translation(inst.transform, view.v.camera_high.xyz,
                                                    view.v.camera_low.xyz);
            const vec3 c =
                vsm_light_space(r, vis_transform_vector(inst.transform, mesh.sphere.xyz) + t);
            const float scale = vis_max_scale(inst.transform);
            const float radius = mesh.sphere.w * scale;
            if (vsm_touches_render(r, level, c, radius)) {
                walk = mesh.lod_nodes != 0ul && (view.v.flags & NPH_VIS_VIEW_LOD) != 0u;
                meshlets = walk ? 0u : mesh.meshlet_count; // level 0's without the walk
            }
        }
    }

    // The roots to the walk's first queue, and its first step's workgroups
    // raised to take them.
    uint nbase;
    VIS_RESERVE(counters.c.node_count[0], walk ? 1u : 0u, nbase);
    if (walk) {
        if (nbase < r.v.max_nodes) {
            VsmUvec2Ref(r.v.node_queue[0]).v[nbase] = uvec2(slot, uint(level) << 24u);
        } else {
            atomicOr(counters.c.overflow, uint(NPH_VSM_OVERFLOW_MESHLETS));
        }
    }
    // The queue's fill, past its capacity where it overflowed: the page
    // budget reads the fullest.
    const uint need = subgroupMax(walk ? nbase + 1u : 0u);
    if (need != 0u && subgroupElect()) {
        atomicMax(counters.c.node_peak, need);
        atomicMax(VsmArgsRef(r.v.args).a.node_args[0][0],
                  (min(need, r.v.max_nodes) + uint(NPH_VIS_LOD_ITEMS) - 1u) /
                      uint(NPH_VIS_LOD_ITEMS));
    }

    // The subgroup's meshlets as items: one atomic for the total, then an
    // equal share each, the owner found by a binary search over the
    // prefix sums (vis_cull_instances.comp).
    const uint inclusive = subgroupInclusiveAdd(meshlets);
    const uint first = inclusive - meshlets;
    const uint total = subgroupAdd(meshlets);
    uint base = 0u;
    if (total != 0u && subgroupElect()) {
        base = atomicAdd(counters.c.meshlet_count, total);
    }
    // Each level's items for the page budget: one level for the subgroup
    // where the dispatch's z names it (or its items share one), else each
    // lane's own (the cells' items are of any level).
    if (subgroupAllEqual(level)) {
        if (total != 0u && subgroupElect()) {
            atomicAdd(counters.c.level_cost[level][NPH_VSM_COST_ITEMS], total);
        }
    } else if (meshlets != 0u) {
        atomicAdd(counters.c.level_cost[level][NPH_VSM_COST_ITEMS], meshlets);
    }
    base = subgroupBroadcastFirst(base);
    const uint rounds = (total + gl_SubgroupSize - 1u) / gl_SubgroupSize;
    for (uint round = 0u; round < rounds; ++round) {
        const uint k = round * gl_SubgroupSize + gl_SubgroupInvocationID;
        uint owner = 0u;
        for (uint step = gl_SubgroupSize >> 1u; step != 0u; step >>= 1u) {
            const uint v = subgroupShuffle(inclusive, owner + step - 1u);
            if (v <= k) {
                owner += step;
            }
        }
        const uint owner_slot = subgroupShuffle(slot, owner);
        const uint owner_first = subgroupShuffle(first, owner);
        const int owner_level = subgroupShuffle(level, owner);
        if (k < total) {
            const uint index = base + k;
            if (index < r.v.max_meshlets) {
                // The meshlet stays under 2^24: no carry into the level.
                VsmUvec2Ref(r.v.meshlets).v[index] =
                    uvec2(owner_slot, (k - owner_first) | (uint(owner_level) << 24u));
            } else {
                atomicOr(counters.c.overflow, uint(NPH_VSM_OVERFLOW_MESHLETS));
            }
        }
    }
}

void cull_meshlets(VisViewRef view, VsmViewRef r)
{
    VsmCountersRef counters = VsmCountersRef(r.v.counters);
    const uint i = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 64u +
                   gl_LocalInvocationIndex;
    uint draws = 0u;
    int level = 0;
    uint slot = 0u;
    uint meshlet = 0u;
    ivec4 rect = ivec4(1, 0, 0, 0);
    NphVisMesh mesh;
    uvec4 m = uvec4(0u);
    if (i < min(counters.c.meshlet_count, r.v.max_meshlets)) {
        const uvec2 item = VsmUvec2Ref(r.v.meshlets).v[i];
        slot = item.x;
        meshlet = item.y & 0xFFFFFFu;
        level = int((item.y >> 24u) & VSM_ITEM_LEVEL_MASK);
        const NphVisInstance inst = VisInstancesRef(view.v.instances).i[slot];
        mesh = VisMeshesRef(view.v.meshes).m[inst.mesh];
        m = VisMeshletsRef(mesh.meshlets).m[meshlet];
        // A cluster of a group too coarse for the level, from the walk: in
        // the cut where its maker's error is fine enough (level 0's is 0).
        bool lod_out = false;
        if ((item.y & VSM_ITEM_LOD) != 0u && (inst.flags & NPH_VIS_INSTANCE_FINEST) == 0u) {
            lod_out = vis_lod_maker_error(mesh, meshlet) >
                      vsm_lod_threshold(r, level, vis_max_scale(inst.transform));
        }
        const uvec4 b0 = VisMeshletBoundsRef(mesh.meshlet_bounds).b[meshlet * 2u];
        const vec3 t = vis_relative_translation(inst.transform, view.v.camera_high.xyz,
                                                view.v.camera_low.xyz);
        const vec3 c =
            vsm_light_space(r, vis_transform_vector(inst.transform, uintBitsToFloat(b0.xyz)) + t);
        const float radius = uintBitsToFloat(b0.w) * vis_max_scale(inst.transform);
        if (!lod_out && !vsm_beyond(r, level, c, radius)) {
            rect = vsm_sphere_rect(r, level, c, radius);
            if (rect.x <= rect.y) {
                // Only the rows with a page to draw.
                for (uint k = uint(rect.z) >> 5u; k <= uint(rect.w) >> 5u; ++k) {
                    uint rows = vsm_render_rows(r, level, k, rect.z, rect.w);
                    while (rows != 0u) {
                        const int y = int(k * 32u + uint(findLSB(rows)));
                        rows &= rows - 1u;
                        for (uint w = uint(rect.x) >> 5u; w <= uint(rect.y) >> 5u; ++w) {
                            draws += bitCount(vsm_row_word(r.v.render, level, y, w) &
                                              vsm_word_mask(w, rect.x, rect.y));
                        }
                    }
                }
            }
        }
    }
    // A meshlet record without vertices is a voxel cluster.
    const bool voxels = k_voxels && (m.z & 0xFFFFu) == 0u;
    // The draws' slots in their lists, a subgroup's together (VIS_RESERVE),
    // and what each level's pages cost the lists (the page budget). The
    // list mixes levels, though a subgroup's items are mostly of one: then
    // its totals count for that level; else the subgroup's lanes of each
    // level add theirs together, a level a round, the first pending one.
    const bool one_level = subgroupAllEqual(level);
    const uint triangles = voxels ? 0u : draws;
    const uint voxel = voxels ? draws : 0u;
    const uint triangle_total = subgroupAdd(triangles);
    const uint voxel_total = k_voxels ? subgroupAdd(voxel) : 0u;
    uint first_at = 0u;
    uint first_voxel = 0u;
    if (subgroupElect()) {
        if (triangle_total != 0u) {
            first_at = atomicAdd(counters.c.draw_count, triangle_total);
            if (one_level) {
                atomicAdd(counters.c.level_cost[level][NPH_VSM_COST_DRAWS], triangle_total);
            }
        }
        if (voxel_total != 0u) {
            first_voxel = atomicAdd(counters.c.voxel_draw_count, voxel_total);
            if (one_level) {
                atomicAdd(counters.c.level_cost[level][NPH_VSM_COST_VOXEL_DRAWS], voxel_total);
            }
        }
    }
    uint at = subgroupBroadcastFirst(first_at) + subgroupExclusiveAdd(triangles);
    uint voxel_at =
        k_voxels ? subgroupBroadcastFirst(first_voxel) + subgroupExclusiveAdd(voxel) : 0u;
    bool pending = !one_level && draws != 0u;
    while (subgroupAny(pending)) {
        if (pending) {
            const int first = subgroupBroadcastFirst(level);
            if (level == first) {
                const uint t = subgroupAdd(triangles);
                const uint v = subgroupAdd(voxel);
                if (subgroupElect()) {
                    if (t != 0u) {
                        atomicAdd(counters.c.level_cost[first][NPH_VSM_COST_DRAWS], t);
                    }
                    if (v != 0u) {
                        atomicAdd(counters.c.level_cost[first][NPH_VSM_COST_VOXEL_DRAWS], v);
                    }
                }
                pending = false;
            }
        }
    }
    if (draws == 0u) {
        return;
    }
    const ivec2 window = vsm_window(r, level);
    const bool indirect = (view.v.flags & NPH_VIS_VIEW_MESH_SHADERS) == 0u;
    for (uint k = uint(rect.z) >> 5u; k <= uint(rect.w) >> 5u; ++k) {
        uint rows = vsm_render_rows(r, level, k, rect.z, rect.w);
        while (rows != 0u) {
            const int y = int(k * 32u + uint(findLSB(rows)));
            rows &= rows - 1u;
            for (uint w = uint(rect.x) >> 5u; w <= uint(rect.y) >> 5u; ++w) {
                uint bits =
                    vsm_row_word(r.v.render, level, y, w) & vsm_word_mask(w, rect.x, rect.y);
                while (bits != 0u) {
                    const int x = int(w * 32u + uint(findLSB(bits)));
                    bits &= bits - 1u;
                    const uint entry = vsm_entry(level, ivec2(x, y) + window);
                    if (voxels) {
                        if (voxel_at >= r.v.max_voxel_draws) {
                            atomicOr(counters.c.overflow, uint(NPH_VSM_OVERFLOW_DRAWS));
                            return;
                        }
                        VsmUvec4Ref(r.v.voxel_draws).v[voxel_at] = uvec4(slot, meshlet, entry, 0u);
                        ++voxel_at;
                        continue;
                    }
                    if (at >= r.v.max_draws) {
                        atomicOr(counters.c.overflow, uint(NPH_VSM_OVERFLOW_DRAWS));
                        return;
                    }
                    VsmUvec4Ref(r.v.draws).v[at] = uvec4(slot, meshlet, entry, 0u);
                    if (indirect) {
                        NphVisDraw draw;
                        draw.index_count = (m.z >> 16u) * 3u;
                        draw.instance_count = 1u;
                        draw.first_index = mesh.index_base + m.y * 3u;
                        draw.vertex_offset = int(m.x);
                        draw.first_instance = 0u;
                        VisDrawsRef(r.v.vis_draws).d[at] = draw;
                    }
                    ++at;
                }
            }
        }
    }
}

void cull_cells(VisViewRef view, VsmViewRef r)
{
    const int level = int(gl_WorkGroupID.z);
    const uint i = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 64u +
                   gl_LocalInvocationIndex;
    if (i >= pc.arg0 || !vsm_cell_proxied(view, r, level, i + 1u)) {
        return;
    }
    const uint ask = vsm_cell_request(view, r, level, i + 1u);
    if (ask == NPH_VIS_CELL_NO_REQUEST) {
        return;
    }
    // The box's bounding sphere (its proxy lies within its instances' box).
    VisCellsRef cells = VisCellsRef(view.v.cells);
    const vec3 centre = (cells.c[i].center_high.xyz - view.v.camera_high.xyz) +
                        (cells.c[i].center_low.xyz - view.v.camera_low.xyz);
    if (vsm_touches_requested(r, level, vsm_light_space(r, centre),
                              length(cells.c[i].extent.xyz))) {
        vis_cell_ask(view, i + 1u, ask);
    }
}

// Cells first (ADR-0064): the cells to list at a level with pages to draw
// (see the file comment).
void cull_cells_test(VisViewRef view, VsmViewRef r)
{
    VsmCountersRef counters = VsmCountersRef(r.v.counters);
    const int level = int(VsmArgsRef(r.v.args).a.levels[gl_WorkGroupID.z]);
    const uint i = (gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x) * 64u +
                   gl_LocalInvocationIndex;
    uint run_first = 0u;
    uint count = 0u;
    if (i < view.v.cell_slots) {
        const NphVisCellRun run = VisCellRunsRef(view.v.cell_runs).r[i];
        // A live cell's proxy has an instance at least; a dead slot's none.
        if (run.proxy_count != 0u) {
            VisCellsRef cells = VisCellsRef(view.v.cells);
            const vec3 centre = (cells.c[i].center_high.xyz - view.v.camera_high.xyz) +
                                (cells.c[i].center_low.xyz - view.v.camera_low.xyz);
            if (vsm_touches_render(r, level, vsm_light_space(r, centre),
                                   length(cells.c[i].extent.xyz))) {
                const bool proxied = vsm_cell_proxied(view, r, level, i + 1u);
                run_first = proxied ? run.proxies : run.members;
                count = proxied ? run.proxy_count : run.member_count;
            }
        }
    }
    uint base = 0u;
    VIS_RESERVE(counters.c.cell_work, count, base);
    uint record = 0u;
    VIS_RESERVE(counters.c.cells_listed, count != 0u ? 1u : 0u, record);
    if (count != 0u && record < r.v.max_cell_listed) {
        VsmUvec4Ref(r.v.cell_listed).v[record] = uvec4(base, run_first, count, uint(level));
    }
}

// A listed (cell, level) pair's run as (instance, level) items, a workgroup
// a pair: many at once hide the loads' latency.
void cull_cells_expand(VisViewRef view, VsmViewRef r)
{
    VsmCountersRef counters = VsmCountersRef(r.v.counters);
    const uint record = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    if (record >= min(counters.c.cells_listed, r.v.max_cell_listed)) {
        return;
    }
    const uvec4 l = VsmUvec4Ref(r.v.cell_listed).v[record];
    VisUintRef entries = VisUintRef(view.v.cell_members);
    VisUintRef work = VisUintRef(r.v.cell_work);
    for (uint j = gl_LocalInvocationIndex; j < l.z; j += 64u) {
        if (l.x + j < r.v.max_cell_work) {
            work.v[l.x + j] = entries.v[l.y + j] | (l.w << 28u);
        } else {
            // Past the list: these casters are left out, and the fixup keeps
            // the frame's pages dirty to be drawn again.
            atomicOr(counters.c.overflow, uint(NPH_VSM_OVERFLOW_MESHLETS));
        }
    }
}

void main()
{
    VisViewRef view = VisViewRef(pc.view);
    VsmViewRef r = VsmViewRef(ViewRef(view.v.render_view).v.vsm);
    if (pc.mode == NPH_VSM_CULL_INSTANCES) {
        cull_instances(view, r);
    } else if (pc.mode == NPH_VSM_CULL_CELLS) {
        cull_cells(view, r);
    } else if (pc.mode == NPH_VSM_CULL_CELLS_TEST) {
        cull_cells_test(view, r);
    } else if (pc.mode == NPH_VSM_CULL_CELLS_EXPAND) {
        cull_cells_expand(view, r);
    } else {
        cull_meshlets(view, r);
    }
}
