// The top-level acceleration structure's instance records of a production
// frame (docs/render.md "Shadows"; engine/render/src/rt.c), the
// VkAccelerationStructureInstanceKHR records of gpu/accel.h
// (NphGpuAccelInstance): the live, shown instances' records from the start of
// the array in their slots' order, each named by its slot (the custom index),
// and every record after them inactive (no structure, a zero mask), so that
// the inactive ones are all at its end (rt.c says why). In slot order, the
// records of a scene whose instances stay are the same records in the same
// places frame after frame, which an update of the top level in place needs
// (ADR-0100: it refits the tree its build made over them). Three dispatches,
// a workgroup a block of 64 slots, an invocation a slot:
//
//   mode 0: each block's live slots, counted;
//   mode 1: one workgroup: each block's first record, the counts summed
//     before it, in place of its count, and their total after the last
//     block's (and in the counters' rt_instances);
//   mode 2: each block's live instances' records, in slot order from the
//     block's first (an inclusive scan in shared memory, which counts on no
//     grouping of the invocations into subgroups); and the records past the
//     total, inactive.
//
// A block is one round of a workgroup: a scene of a few thousand slots runs
// its blocks side by side, where blocks of many rounds each ran them one
// after another (16 rounds took Bistro's 3,000 slots 0.06 ms).
//
// A record is in the top level's space: camera relative, then shifted by
// the view's tlas_offset. The mesh's bottom level holds its quantised
// positions, so the dequantisation is folded into the transform:
// L (offset + scale q) + t = (L diag(scale)) q + (L offset + t).
//
// arg0 is the slot count; arg2 and arg3 the records' address, low and high;
// arg1 and arg4 the blocks' counts' (u32[blocks + 1]), low and high.
#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "vis_common.glsl"

layout(local_size_x = 64) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

// The slots a workgroup takes in modes 0 and 2 (rt.c RT_INSTANCE_BLOCK).
#define RT_BLOCK 64u

shared uint s_count; // mode 0: the block's live slots
shared uint s_sums[64];

struct AccelInstance {
    vec4 row0; // the object-to-world rows
    vec4 row1;
    vec4 row2;
    uint index_and_mask;
    uint offset_and_flags;
    uint64_t blas;
};

NPH_BUFFER_REF(AccelInstancesRef) { AccelInstance a[]; };

// VK_GEOMETRY_INSTANCE_TRIANGLE_FACING_CULL_DISABLE_BIT_KHR, in the flags'
// byte: shadows come from both sides.
#define RT_INSTANCE_NO_FACE_CULL (1u << 24u)
// VK_GEOMETRY_INSTANCE_FORCE_NO_OPAQUE_BIT_KHR: every triangle a candidate, which
// the shaders that trace put to its material's alpha test (rt_mask.glsl). The
// bottom levels' geometries are opaque, so the other instances never come back
// to a shader.
#define RT_INSTANCE_NO_OPAQUE (8u << 24u)

// Whether slot `i` holds a shown instance of a mesh with a bottom level: its record is active.
bool slot_live(VisViewRef view, uint i)
{
    if (i >= pc.arg0) {
        return false;
    }
    VisInstancesRef instances = VisInstancesRef(view.v.instances);
    if ((instances.i[i].flags & NPH_VIS_INSTANCE_VISIBLE) == 0u) {
        return false;
    }
    return VisMeshesRef(view.v.meshes).m[instances.i[i].mesh].blas != 0ul;
}

// An inactive record: no structure, a zero mask.
void write_inactive(AccelInstancesRef out_ref, uint at)
{
    AccelInstance o;
    o.row0 = vec4(0.0);
    o.row1 = vec4(0.0);
    o.row2 = vec4(0.0);
    o.index_and_mask = 0u;
    o.offset_and_flags = 0u;
    o.blas = 0ul;
    out_ref.a[at] = o;
}

// Slot `i`'s record at `at`: the slot is live.
void write_record(VisViewRef view, AccelInstancesRef out_ref, uint i, uint at)
{
    const NphVisInstance inst = VisInstancesRef(view.v.instances).i[i];
    const NphVisMesh mesh = VisMeshesRef(view.v.meshes).m[inst.mesh];
    const vec3 t = vis_relative_translation(inst.transform, view.v.camera_high.xyz,
                                            view.v.camera_low.xyz) +
                   ViewRef(view.v.render_view).v.tlas_offset.xyz;
    // A flat mesh's scale is 0 along the axis it has no extent on, and its
    // quantised coordinate 0 there: any scale gives the same points, and 1 a
    // transform that can be inverted, which a ray needs to reach it (rt.c).
    const vec3 s = mix(mesh.position_scale.xyz, vec3(1.0), equal(mesh.position_scale.xyz, vec3(0.0)));
    const vec3 off = mesh.position_offset.xyz;
    AccelInstance o;
    o.row0 = vec4(inst.transform.row0.xyz * s, dot(inst.transform.row0.xyz, off) + t.x);
    o.row1 = vec4(inst.transform.row1.xyz * s, dot(inst.transform.row1.xyz, off) + t.y);
    o.row2 = vec4(inst.transform.row2.xyz * s, dot(inst.transform.row2.xyz, off) + t.z);
    o.index_and_mask = i | (0xFFu << 24u);
    // An instance with an alpha-tested or a blended material, on any of its slots: the rays
    // put its triangles to their materials (rt_mask.glsl).
    bool masked = false;
    MaterialsRef materials = MaterialsRef(view.v.materials);
    for (uint slot = 0u; slot < inst.material_count; ++slot) {
        masked = masked || materials.m[vis_instance_material(view, inst, slot)].alpha_mode != 0u;
    }
    // A mesh with triangles for the rays alone (ADR-0096): they are traced where they hold for
    // the instance this frame, each trimmed submesh drawn with a material the rays hold to the
    // key they were made for (NphRenderMaterialData.ray_key, 0 on a frame its rays read another
    // level); elsewhere the bottom level of its own triangles (ADR-0098), whose hits the shaders
    // read as they read any (vis_ray_triangle).
    uint64_t blas = mesh.blas;
    if (mesh.rays != 0ul) {
        VisUintRef keys = VisUintRef(mesh.rays);
        VisUvec2Ref subs = VisUvec2Ref(mesh.submeshes);
        const uint count = keys.v[0];
        bool hold = true;
        for (uint s = 0u; s < count; ++s) {
            const uint key = keys.v[1u + s];
            if (key != 0u) {
                hold = hold &&
                       materials.m[vis_instance_material(view, inst, subs.v[s].x)].ray_key == key;
            }
        }
        if (!hold) {
            blas = mesh.blas_own;
            atomicAdd(VisCountersRef(view.v.counters).c.rt_own, 1u);
        } else {
            atomicAdd(VisCountersRef(view.v.counters).c.rt_trimmed, 1u);
        }
    }
    o.offset_and_flags = RT_INSTANCE_NO_FACE_CULL | (masked ? RT_INSTANCE_NO_OPAQUE : 0u);
    o.blas = blas;
    out_ref.a[at] = o;
}

void main()
{
    VisViewRef view = VisViewRef(pc.view);
    AccelInstancesRef out_ref = AccelInstancesRef(uint64_t(pc.arg2) | (uint64_t(pc.arg3) << 32ul));
    VisUintRef counts = VisUintRef(uint64_t(pc.arg1) | (uint64_t(pc.arg4) << 32ul));
    const uint lid = gl_LocalInvocationIndex;
    const uint blocks = (pc.arg0 + RT_BLOCK - 1u) / RT_BLOCK;
    const uint i = gl_WorkGroupID.x * RT_BLOCK + lid;
    if (pc.mode == 0u) {
        if (lid == 0u) {
            s_count = 0u;
        }
        barrier();
        if (slot_live(view, i)) {
            atomicAdd(s_count, 1u);
        }
        barrier();
        if (lid == 0u) {
            counts.v[gl_WorkGroupID.x] = s_count;
        }
        return;
    }
    if (pc.mode == 1u) {
        // A run of blocks for each invocation: its sum; the sums of the runs before it; then each
        // block's first record in place of its count.
        const uint run = (blocks + 63u) / 64u;
        const uint lo = min(lid * run, blocks);
        const uint hi = min(lo + run, blocks);
        uint sum = 0u;
        for (uint b = lo; b < hi; ++b) {
            sum += counts.v[b];
        }
        s_sums[lid] = sum;
        barrier();
        if (lid == 0u) {
            uint total = 0u;
            for (uint k = 0u; k < 64u; ++k) {
                const uint v = s_sums[k];
                s_sums[k] = total;
                total += v;
            }
            counts.v[blocks] = total;
            VisCountersRef(view.v.counters).c.rt_instances = total;
        }
        barrier();
        uint at = s_sums[lid];
        for (uint b = lo; b < hi; ++b) {
            const uint n = counts.v[b];
            counts.v[b] = at;
            at += n;
        }
        return;
    }
    // Mode 2: the block's live slots ranked in slot order by an inclusive scan in shared memory
    // (which counts on no grouping of the invocations into subgroups); and the records past the
    // total inactive.
    const uint total = counts.v[blocks];
    const uint base = counts.v[gl_WorkGroupID.x];
    const bool live = slot_live(view, i);
    s_sums[lid] = live ? 1u : 0u;
    barrier();
    for (uint d = 1u; d < 64u; d <<= 1u) {
        const uint v = lid >= d ? s_sums[lid - d] : 0u;
        barrier();
        s_sums[lid] += v;
        barrier();
    }
    if (live) {
        write_record(view, out_ref, i, base + s_sums[lid] - 1u);
    }
    if (i >= total && i < pc.arg0) {
        write_inactive(out_ref, i);
    }
}
