// The hierarchical depth buffer (docs/render.md "The production path"; the
// Hi-Z of Greene, Kass & Miller, "Hierarchical Z-Buffer Visibility",
// SIGGRAPH 1993, as GPU-driven renderers use it for occlusion culling): each
// texel holds the farthest depth of the texels below it, which under
// reverse-Z is the smallest value.
//
// Mip 0 is half the screen rounded up: each texel takes a 2 x 2 block of
// pixels, clamped at the last row and column. Every later mip is the one
// above halved and rounded down, as Vulkan sizes mips, so where the source
// has an odd number of texels its last one has no block of its own: the
// destination's last texel takes it too (a 3-wide footprint). Every source
// texel thus lies under exactly one destination texel, and mip-m texel t
// covers mip-0 texels [t 2^m, (t + 1) 2^m), the last one reaching the edge,
// which is the mapping vis_hzb_occluded relies on. Rounding up instead
// would leave a mip larger than Vulkan made it and lose its last row and
// column, and with them the farthest depth under them. This shader writes
// mip 0; vis_hzb_mips.comp builds the others.
//
// Mode 0 reads the depth half of the visibility buffer for every texel.
// Mode 2 is mode 0 for the tiles phase 1 drew into alone,
// a workgroup per NPH_VIS_HZB_TILE-pixel tile (16 x 16 mip-0 texels): the
// pyramid after phase 1 differs from the one after phase 0 only there,
// and phase 1 usually draws little, so this skips most of a full read of
// the visibility buffer (the cull pass marks the tiles; a cluster it cannot
// bound marks them all). arg0 is the visibility buffer's bindless storage
// index, arg1 mip 0's, arg2 and arg3 the visibility buffer's extent.
//
// Modes 0 and 2 also request the virtual shadow map's pages where the view
// has one (vsm_common.glsl): each pixel the pages its shading will read,
// from the depth they already read. Between them the two cover every
// pixel's final surface (phase 1 changed only the tiles mode 2 reads
// again); a surface phase 1 then hid may have asked for pages no pixel
// shows, which costs only their drawing.
//
// Where the frame has ambient occlusion, modes 0 and 2 write its depths'
// mip 0 too (arg4, its bindless storage index; NPH_VIS_NO_AO for none): each
// texel its block's top-left pixel's depth, and past mip 0's extent, which
// the occlusion's depths round up to a multiple of the group
// (ao_depth.comp), the last row's and column's. The depths are read here
// anyway, and the same two passes cover the frame's final depth.
#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_vote : require
#include "vis_common.glsl"
#include "nph_bindless_int64.glsl"
#define NPH_VSM_REQUESTS
#include "vsm_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

float source_depth(ivec2 p)
{
    return vis_depth(imageLoad(nph_u64images_2d[nonuniformEXT(pc.arg0)], p).x);
}

// The values of `v` at or above `floor`, VSM_NONE elsewhere.
uvec4 at_or_above(uvec4 v, uint floor)
{
    return mix(uvec4(VSM_NONE), v, greaterThanEqual(v, uvec4(floor)));
}

// A request's pages as bits (vsm_request_bit), VSM_NONE where it has fewer.
uvec4 request_bits(uint request)
{
    return uvec4(vsm_request_bit(request, 0u), vsm_request_bit(request, 1u),
                 vsm_request_bit(request, 2u), vsm_request_bit(request, 3u));
}

// Requests the virtual shadow map's pages for the 2 x 2 pixels at `lo`
// (clamped to `last`; none outside the mip): the pages each pixel's
// shading may read (vsm_request), from `depth`, the four pixels' depths
// (row by row; 0 for none). Mostly every pixel of the subgroup needs the
// same one page, which one invocation sets. Otherwise, round after round,
// the lowest page any invocation still needs is set by one of those that
// need it: as many rounds as the subgroup needs distinct pages.
void request_pages(VisViewRef view, VsmViewRef r, ivec2 lo, ivec2 last, vec4 depth)
{
    uvec4 requests = uvec4(VSM_NONE);
    for (int k = 0; k < 4; ++k) {
        if (depth[k] > 0.0) { // else the background, or no pixel
            const ivec2 q = min(lo + ivec2(k & 1, k >> 1), last);
            const vec2 ndc = (vec2(q) + 0.5) * view.v.viewport.zw * 2.0 - 1.0;
            const vec4 h = r.v.light_from_clip * vec4(ndc, depth[k], 1.0);
            requests[k] = vsm_request(r, h.xyz / h.w);
        }
    }
    // The usual case: one single-page request in every invocation that
    // has one (VSM_NONE, the largest value, is no request).
    const uint first = min(min(requests.x, requests.y), min(requests.z, requests.w));
    const uvec4 other = uvec4(notEqual(requests, uvec4(first))) &
                        uvec4(notEqual(requests, uvec4(VSM_NONE)));
    const bool alone = (other.x | other.y | other.z | other.w) == 0u;
    const uint lowest = subgroupMin(first);
    if (subgroupAll(first == VSM_NONE || (alone && first == lowest && (first >> 18u) == 0u))) {
        const uint bit = vsm_request_bit(lowest, 0u);
        if (bit != VSM_NONE && subgroupElect()) {
            atomicOr(VsmBitsRef(r.v.requests).w[bit >> 5u], 1u << (bit & 31u));
        }
        return;
    }
    const uvec4 a = request_bits(requests.x);
    const uvec4 b = request_bits(requests.y);
    const uvec4 c = request_bits(requests.z);
    const uvec4 d = request_bits(requests.w);
    uint floor = 0u;
    for (;;) {
        const uvec4 m = min(min(at_or_above(a, floor), at_or_above(b, floor)),
                            min(at_or_above(c, floor), at_or_above(d, floor)));
        const uint mine = min(min(m.x, m.y), min(m.z, m.w));
        const uint bit = subgroupMin(mine);
        if (bit == VSM_NONE) {
            break;
        }
        if (mine == bit && subgroupElect()) {
            atomicOr(VsmBitsRef(r.v.requests).w[bit >> 5u], 1u << (bit & 31u));
        }
        floor = bit + 1u;
    }
}

void main()
{
    if (pc.mode == 2u) {
        VisViewRef view = VisViewRef(pc.view);
        const uint tile = gl_WorkGroupID.y * view.v.hzb_tiles_x + gl_WorkGroupID.x;
        const bool dirty =
            (VisUintRef(view.v.hzb_dirty).v[tile >> 5u] & (1u << (tile & 31u))) != 0u;
        if (!dirty && VisCountersRef(view.v.counters).c.hzb_full == 0u) {
            return;
        }
    }
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 src = ivec2(pc.arg2, pc.arg3);
    const ivec2 dst = (src + 1) / 2;
    const ivec2 last = src - 1;
    const ivec2 lo = min(p * 2, last);
    const bool inside = all(lessThan(p, dst));
    // The 2 x 2 block (clamped at the last row and column), row by row.
    vec4 block = vec4(0.0);
    if (inside) {
        for (int k = 0; k < 4; ++k) {
            block[k] = source_depth(min(lo + ivec2(k & 1, k >> 1), last));
        }
    }
    {
        // Every invocation of the subgroup takes part in the requests.
        VisViewRef view = VisViewRef(pc.view);
        const uint64_t vsm = ViewRef(view.v.render_view).v.vsm;
        if (vsm != 0ul) {
            request_pages(view, VsmViewRef(vsm), lo, last, block);
        }
    }
    if (pc.arg4 != NPH_VIS_NO_AO) {
        const float top_left = inside ? block.x : source_depth(2 * min(p, dst - 1));
        imageStore(nph_images_2d[nonuniformEXT(pc.arg4)], p, vec4(top_left, 0.0, 0.0, 0.0));
    }
    if (!inside) {
        return;
    }
    float d = min(min(block.x, block.y), min(block.z, block.w));
    // The last texel of a row or column reaches the source's edge: a third
    // row or column where the source's extent is odd.
    const ivec2 hi = ivec2(p.x == dst.x - 1 ? last.x : p.x * 2 + 1,
                           p.y == dst.y - 1 ? last.y : p.y * 2 + 1);
    for (int y = lo.y; y <= hi.y; ++y) {
        for (int x = lo.x; x <= hi.x; ++x) {
            if (x > lo.x + 1 || y > lo.y + 1) {
                d = min(d, source_depth(ivec2(x, y)));
            }
        }
    }
    imageStore(nph_images_2d[nonuniformEXT(pc.arg1)], p, vec4(d, 0.0, 0.0, 0.0));
}
