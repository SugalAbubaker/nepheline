// The depth pyramid's page requests for blocks of pixels (vsm_block.glsl)
// against every pixel's own (vsm_request), for the render tests
// (Vsm.block_requests_are_each_pixels): each invocation a 2 x 2 block of a
// depth image, as vis_hzb.comp has them, the block's requests going in the
// view's bitmask and its pixels' own in the reference. Not used by the
// renderer.
#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_vote : require
#include "vis_common.glsl"
#define NPH_VSM_REQUESTS
#include "vsm_common.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant, scalar) uniform Push { NphVsmTestPush pc; };

#include "vsm_block.glsl"

NPH_BUFFER_REF(VsmTestDepthsRef) { float d[]; };

void main()
{
    const ivec2 size = ivec2(pc.width, pc.height);
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 last = size - 1;
    const ivec2 lo = min(p * 2, last);
    // Past the image: no pixels (but a part in the subgroup's requests).
    vec4 depth = vec4(0.0);
    if (all(lessThan(p, (size + 1) / 2))) {
        for (int k = 0; k < 4; ++k) {
            const ivec2 q = min(lo + ivec2(k & 1, k >> 1), last);
            depth[k] = VsmTestDepthsRef(pc.depths).d[q.y * size.x + q.x];
        }
    }
    const vec2 scale = 2.0 / vec2(size);
    VsmViewRef r = VsmViewRef(pc.view);
    vsm_request_block(r, lo, last, scale, depth);
    // Each pixel's own at its block's slope, the rule stated here again rather than taken from
    // vsm_block_slope: the plane's only where the four are surfaces on one plane (within a quarter
    // of the block's extent), else none.
    const ivec2 hi = min(lo + 1, last);
    const vec2 n0 = vsm_ndc(lo, scale);
    const vec2 n1 = vsm_ndc(hi, scale);
    float slope = 1.0;
    if (all(greaterThan(depth, vec4(0.0)))) {
        const vec3 p0 = vsm_ray_point(r, n0, depth.x);
        const vec3 p1 = vsm_ray_point(r, vec2(n1.x, n0.y), depth.y);
        const vec3 p2 = vsm_ray_point(r, vec2(n0.x, n1.y), depth.z);
        const vec3 p3 = vsm_ray_point(r, n1, depth.w);
        const vec3 bend = p3 - p1 - p2 + p0;
        const float span = max(dot(p1 - p0, p1 - p0), dot(p2 - p0, p2 - p0));
        if (dot(bend, bend) <= 0.0625 * span) {
            slope = vsm_block_slope(p0, p1, p2, p3, depth);
        }
    }
    for (int k = 0; k < 4; ++k) {
        if (depth[k] > 0.0) {
            const ivec2 q = min(lo + ivec2(k & 1, k >> 1), last);
            const uint request =
                vsm_request(r, vsm_ray_point(r, vsm_ndc(q, scale), depth[k]), slope);
            if (request != VSM_NONE) {
                vsm_set_request(pc.reference, request);
            }
        }
    }
}
