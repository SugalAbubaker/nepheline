// SPDX-License-Identifier: Apache-2.0
// Meshlet culling (docs/render.md "The production path"), the second level
// of the GPU-driven pipeline: each invocation takes one (instance, meshlet)
// work item and tests the meshlet's bounding sphere against the frustum,
// its normal cone against the camera (all triangles facing away;
// Kapoulkine, meshoptimizer, 2017; docs/cook.md "The meshlet normal
// cone"), and its sphere against the hierarchical depth, in the two phases
// of vis_cull_instances.comp:
//
//   phase 0: the meshlets of the instances phase 0 kept; occlusion against
//     the previous frame's HZB from the previous camera and transform,
//     occluded meshlets deferred to phase 1;
//   phase 1: the meshlets phase 0 deferred, then those of the instances
//     phase 1 found visible; occlusion against this frame's HZB.
//
// A meshlet that survives becomes a visible cluster (instance, meshlet,
// resolved material, flags) and joins one of its phase's raster lists:
// masked materials (alpha tested) to the hardware raster, which samples
// their texture; opaque clusters of small triangles to the software raster
// (vis_sw_raster.comp): those whose bounding sphere projects into at most
// NPH_VIS_SW_MAX_PIXELS across, with that box's area shared among the
// triangles at most sw_raster_pixels across each; voxel clusters (a
// meshlet record without vertices: render/voxel.h; ADR-0061) to the voxel
// raster (vis_voxel_raster.comp), whatever their material, whose look they
// carry; the rest to the hardware raster. Blended materials are not drawn
// into the visibility buffer at all: the transparent pass draws them.
//
// A cluster of a mesh's coarser levels of detail came from a group of the
// hierarchy (vis_cull_nodes.comp) whose own error is too large for the view;
// it is drawn only where the error of the group that made it is not
// (render/cluster_lod.h): otherwise the finer clusters it stands for are.
#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "vis_common.glsl"

layout(local_size_x = 64) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; };

// Whether voxel clusters may appear (the renderer holds a mesh with voxel
// levels): without, their routing compiles out, which costs the cull 0.5 to
// 0.7 us a phase where compiled in (render_perf's 4K field, 40 us a phase).
layout(constant_id = 0) const bool k_voxels = false;

void main()
{
    VisViewRef view = VisViewRef(pc.view);
    VisCountersRef counters = VisCountersRef(view.v.counters);
    const uint phase = pc.phase;
    const uint group = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;

    uint slot = 0u;
    uint meshlet = 0u;
    bool valid = false;
    const uint i = group * 64u + gl_LocalInvocationIndex;
    const uint count = phase == 0u ? min(counters.c.cull_meshlets, view.v.max_cull_meshlets)
                                   : min(counters.c.deferred_meshlets, view.v.max_deferred);
    if (i < count) {
        const uvec2 e =
            VisUvec2Ref(phase == 0u ? view.v.cull_meshlets : view.v.deferred_meshlets).v[i];
        slot = e.x;
        meshlet = e.y;
        valid = true;
    }

    bool visible = false;
    bool defer = false;
    bool culled_frustum = false;
    bool culled_cone = false;
    bool culled_occlusion = false;
    bool culled_lod = false;
    uint material = view.v.default_material;
    uint flags = 0u;
    uint triangles = 0u;
    uint bricks = 0u; // a voxel cluster's
    bool voxels = false;
    uint first_index = 0u; // the indirect raster's draw: the meshlet's corners in the index pool
    uint vertex_offset = 0u;
    vec3 c = vec3(0.0); // the meshlet's sphere, camera relative
    float r = 0.0;
    bool skin = false; // a masked cluster at the front of its instance (below)
    if (valid) {
        const NphVisInstance inst = VisInstancesRef(view.v.instances).i[slot];
        const NphVisMesh mesh = VisMeshesRef(view.v.meshes).m[inst.mesh];
        const uvec4 m = VisMeshletsRef(mesh.meshlets).m[meshlet];
        voxels = k_voxels && (m.z & 0xFFFFu) == 0u;
        triangles = voxels ? 0u : m.z >> 16u;
        bricks = voxels ? m.z >> 16u : 0u;
        first_index = mesh.index_base + m.y * 3u;
        vertex_offset = m.x;
        // The material of the meshlet's submesh, through the instance's map.
        const uint mslot = VisUvec2Ref(mesh.submeshes).v[m.w].x;
        const uint handle =
            mslot < inst.material_count ? VisUintRef(view.v.material_map).v[inst.material_base + mslot]
                                        : 0u;
        material = vis_resolve_material(view, handle);
        // The two fields, not a copy of the material: Ubuntu 24.04's glslang
        // (14.0) gives a local copy the buffer's array types, ArrayStride
        // included, which spirv-val rejects unless the optimiser removes the
        // copy (VUID-StandaloneSpirv-None-10684; docs/build.md "Shaders").
        MaterialsRef materials = MaterialsRef(view.v.materials);
        const uint material_flags = materials.m[material].flags;
        const uint alpha_mode = materials.m[material].alpha_mode;
        const bool double_sided = (material_flags & NPH_RENDER_MATERIAL_DOUBLE_SIDED) != 0u;
        // A voxel is opaque, and lit as the voxelizer saw the mesh's own
        // materials: no alpha test, and no blending.
        flags = ((inst.flags & NPH_VIS_INSTANCE_MIRRORED) != 0u ? uint(NPH_VIS_CLUSTER_MIRRORED) : 0u) |
                (double_sided ? uint(NPH_VIS_CLUSTER_DOUBLE_SIDED) : 0u) |
                (alpha_mode == 1u && !voxels ? uint(NPH_VIS_CLUSTER_MASKED) : 0u) |
                ((inst.flags & NPH_VIS_INSTANCE_MOVED) != 0u ? uint(NPH_VIS_CLUSTER_MOVED) : 0u) |
                (voxels ? uint(NPH_VIS_CLUSTER_VOXELS) : 0u);
        if (alpha_mode != 2u || voxels) {
            VisMeshletBoundsRef bounds = VisMeshletBoundsRef(mesh.meshlet_bounds);
            const uvec4 b0 = bounds.b[meshlet * 2u];
            const uvec4 b1 = bounds.b[meshlet * 2u + 1u];
            const vec3 center = uintBitsToFloat(b0.xyz);
            const float radius = uintBitsToFloat(b0.w);
            const float scale = vis_max_scale(inst.transform);
            const vec3 t = vis_relative_translation(inst.transform, view.v.camera_high.xyz,
                                                    view.v.camera_low.xyz);
            c = vis_transform_vector(inst.transform, center) + t;
            r = radius * scale;
            const vec4 cone = unpackSnorm4x8(b1.x);
            if ((view.v.flags & NPH_VIS_VIEW_LOD) != 0u && mesh.lod_makers != 0ul) {
                // The group that made it, tested as the walk tests that
                // group's own clusters (level 0's error of 0 never is).
                culled_lod = vis_lod_group_too_coarse(view, inst.transform,
                                                      vis_lod_maker_sphere(mesh, meshlet),
                                                      vis_lod_maker_error(mesh, meshlet));
            }
            if (culled_lod) {
                // A finer level's clusters are drawn instead.
            } else if (!vis_sphere_in_frustum(view, c, r)) {
                culled_frustum = true;
            } else if ((view.v.flags & NPH_VIS_VIEW_CONE_CULLING) != 0u && !double_sided &&
                       !voxels && (inst.flags & NPH_VIS_INSTANCE_SIMILAR) != 0u &&
                       vis_cone_culled(vis_transform_vector(inst.transform, uintBitsToFloat(b1.yzw)) + t,
                                       vis_transform_vector(inst.transform, cone.xyz) / scale,
                                       cone.w)) {
                culled_cone = true;
            } else if ((view.v.flags & NPH_VIS_VIEW_OCCLUSION) != 0u) {
                vec4 rect;
                float depth;
                if (phase == 0u) {
                    if ((view.v.flags & NPH_VIS_VIEW_HZB_VALID) != 0u) {
                        const NphVisTransform pt =
                            VisTransformsRef(view.v.prev_transforms).t[slot];
                        const vec3 ptr = vis_relative_translation(
                            pt, view.v.prev_camera_high.xyz, view.v.prev_camera_low.xyz);
                        const vec3 pw = vis_transform_vector(pt, center) + ptr;
                        const vec3 pv = (view.v.prev_view * vec4(pw, 1.0)).xyz;
                        defer = vis_project_sphere(pv, radius * vis_max_scale(pt),
                                                   view.v.prev_projection, rect, depth) &&
                                vis_hzb_occluded(view, rect + view.v.jitter.zwzw, depth);
                    }
                } else {
                    const vec3 cv = (view.v.view * vec4(c, 1.0)).xyz;
                    culled_occlusion = vis_project_sphere(cv, r, view.v.projection, rect, depth) &&
                                       vis_hzb_occluded(view, rect + view.v.jitter.xyxy, depth);
                }
            }
            visible = !culled_lod && !culled_frustum && !culled_cone && !defer && !culled_occlusion;
        }
        // The front of a masked instance on the mesh path (the skin): the
        // cluster's centre within the nearest skin_fraction of the chord its
        // view ray cuts through the instance's box (the mesh's dequantisation
        // box), whose depth is written after its alpha test so that the leaves
        // behind it are rejected before their fragment shader.
        if (visible && alpha_mode == 1u && !voxels && (view.v.flags & NPH_VIS_VIEW_SKIN) != 0u) {
            const mat3 inv = transpose(vis_normal_matrix(inst.transform));
            const vec3 t = vis_relative_translation(inst.transform, view.v.camera_high.xyz,
                                                    view.v.camera_low.xyz);
            const float dist = length(c);
            const vec3 o = inv * (-t);
            const vec3 d = inv * (c / max(dist, 1e-6));
            const vec3 lo = mesh.position_offset.xyz;
            const vec3 hi = lo + mesh.position_scale.xyz;
            const vec3 a = (lo - o) / d;
            const vec3 b = (hi - o) / d;
            const vec3 near3 = min(a, b);
            const vec3 far3 = max(a, b);
            const float enter = max(max(max(near3.x, near3.y), near3.z), 0.0);
            const float exit = min(min(far3.x, far3.y), far3.z);
            skin = dist - enter <= view.v.skin_fraction * max(exit - enter, 0.0);
        }
    }

    VIS_COUNT(counters.c.meshlets_culled_frustum, culled_frustum);
    VIS_COUNT(counters.c.meshlets_culled_cone, culled_cone);
    VIS_COUNT(counters.c.meshlets_culled_occlusion, culled_occlusion);
    VIS_COUNT(counters.c.lod_clusters_culled, culled_lod);

    // Deferred to phase 1.
    if (phase == 0u) {
        uint d;
        VIS_RESERVE(counters.c.deferred_meshlets, defer ? 1u : 0u, d);
        if (defer) {
            if (d < view.v.max_deferred) {
                VisUvec2Ref(view.v.deferred_meshlets).v[d] = uvec2(slot, meshlet);
            } else {
                atomicOr(counters.c.overflow, uint(NPH_VIS_OVERFLOW_DEFERRED));
            }
        }
    }

    // A visible cluster, then its place in a raster list.
    uint g;
    VIS_RESERVE(counters.c.clusters, visible ? 1u : 0u, g);
    if (visible && g >= view.v.max_clusters) {
        atomicOr(counters.c.overflow, uint(NPH_VIS_OVERFLOW_CLUSTERS));
        visible = false;
    }
    const bool masked = (flags & NPH_VIS_CLUSTER_MASKED) != 0u;
    // Opaque clusters of small triangles rasterise in software (see the
    // file comment). The sphere projecting in front of the near plane also
    // keeps every vertex in front of the camera, which the software raster
    // relies on.
    bool software = false;
    if (visible && !masked && !voxels && (view.v.flags & NPH_VIS_VIEW_SW_RASTER) != 0u) {
        const vec3 cv = (view.v.view * vec4(c, 1.0)).xyz;
        vec4 rect;
        float depth;
        if (vis_project_sphere(cv, r, view.v.projection, rect, depth)) {
            const vec2 extent = (rect.zw - rect.xy) * view.v.viewport.xy;
            const float side = sqrt(extent.x * extent.y / float(max(triangles, 1u)));
            software = max(extent.x, extent.y) <= float(NPH_VIS_SW_MAX_PIXELS) &&
                       side <= view.v.sw_raster_pixels;
        }
    }
    skin = skin && visible;
    uint j0;
    uint j1;
    uint j2;
    uint j3;
    uint j4 = 0u;
    VIS_RESERVE(counters.c.raster_count[phase][NPH_VIS_RASTER_OPAQUE],
                visible && !masked && !software && !voxels ? 1u : 0u, j0);
    VIS_RESERVE(counters.c.raster_count[phase][NPH_VIS_RASTER_MASKED],
                visible && masked && !skin ? 1u : 0u, j1);
    VIS_RESERVE(counters.c.raster_count[phase][NPH_VIS_RASTER_SKIN], skin ? 1u : 0u, j3);
    VIS_RESERVE(counters.c.raster_count[phase][NPH_VIS_RASTER_SOFTWARE],
                visible && software ? 1u : 0u, j2);
    if (k_voxels) {
        VIS_RESERVE(counters.c.raster_count[phase][NPH_VIS_RASTER_VOXEL],
                    visible && voxels ? 1u : 0u, j4);
        VIS_ADD(counters.c.voxel_bricks, visible ? bricks : 0u);
    }
    VIS_ADD(counters.c.triangles, visible ? triangles : 0u);
    if (!visible) {
        return;
    }
    // What phase 1 draws, the depth pyramid after it rebuilds: mark the
    // tiles the cluster's sphere projects onto (the triangles lie inside
    // it), or the whole pyramid when the sphere does not project (it reaches
    // the near plane). A row of tiles is a run of the mask's bits, set a word
    // at a time, so a cluster of any size marks its rectangle in a few
    // atomics: a large one no longer asks for the whole pyramid, whose
    // rebuild cost Bistro's street 0.28 ms on every fourth frame.
    if (phase == 1u) {
        const vec3 cv = (view.v.view * vec4(c, 1.0)).xyz;
        vec4 rect;
        float depth;
        if (vis_project_sphere(cv, r, view.v.projection, rect, depth)) {
            const vec4 px = clamp(rect + view.v.jitter.xyxy, 0.0, 1.0) * view.v.viewport.xyxy;
            const ivec2 t0 = ivec2(px.xy) / NPH_VIS_HZB_TILE;
            const ivec2 t1 = ivec2(min(px.zw, view.v.viewport.xy - 1.0)) / NPH_VIS_HZB_TILE;
            VisUintRef dirty = VisUintRef(view.v.hzb_dirty);
            for (int y = t0.y; y <= t1.y; ++y) {
                const uint first = uint(y) * view.v.hzb_tiles_x + uint(t0.x);
                const uint last = uint(y) * view.v.hzb_tiles_x + uint(t1.x);
                for (uint w = first >> 5u; w <= (last >> 5u); ++w) {
                    const uint lo = max(first, w * 32u) - w * 32u;
                    const uint hi = min(last, w * 32u + 31u) - w * 32u;
                    atomicOr(dirty.v[w], (0xFFFFFFFFu >> (31u - hi)) & (0xFFFFFFFFu << lo));
                }
            }
        } else {
            atomicOr(counters.c.hzb_full, 1u);
        }
    }
    NphVisCluster cluster;
    cluster.instance = slot;
    cluster.meshlet = meshlet;
    cluster.material = material;
    cluster.flags = flags;
    VisClustersRef(view.v.clusters).c[g] = cluster;
    // Every raster list holds at most one entry per cluster, so an index
    // reserved here is below max_clusters.
    const uint kind = voxels     ? uint(NPH_VIS_RASTER_VOXEL)
                      : skin     ? uint(NPH_VIS_RASTER_SKIN)
                      : masked   ? uint(NPH_VIS_RASTER_MASKED)
                      : software ? uint(NPH_VIS_RASTER_SOFTWARE)
                                 : uint(NPH_VIS_RASTER_OPAQUE);
    const uint j = voxels ? j4 : (skin ? j3 : (masked ? j1 : (software ? j2 : j0)));
    VisUintRef(view.v.raster_lists[phase][kind]).v[j] = g;
    if (!software && !voxels && (view.v.flags & NPH_VIS_VIEW_MESH_SHADERS) == 0u) {
        NphVisDraw draw;
        draw.index_count = triangles * 3u;
        draw.instance_count = 1u;
        draw.first_index = first_index;
        draw.vertex_offset = int(vertex_offset);
        draw.first_instance = 0u;
        VisDrawsRef(view.v.draws[phase][kind]).d[j] = draw;
    }
}
