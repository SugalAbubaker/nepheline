// The GPU scene's instance updates (docs/render.md "The GPU scene"), the
// first pass of a frame: each NphVisInstanceUpdate replaces the record at
// its slot and moves the old transform to the previous-transform table
// (motion vectors and phase 1 of occlusion culling read last frame's
// transforms), or, with copy_previous, brings the previous transform up to
// the current one for an instance that moved last frame and not this one.
// A fresh instance has no history: its previous transform is its first.
// NPH_VIS_INSTANCE_MOVED marks the records whose two transforms differ, so
// that the temporal resolve reads both only for those.
// The CPU sends at most one update per slot per frame, so no two
// invocations touch one slot.
#version 460
#include "vis_common.glsl"

layout(local_size_x = 64) in;
layout(push_constant, scalar) uniform Push { NphVisPush pc; }; // arg0: update count

NPH_BUFFER_REF(VisUpdatesRef) { NphVisInstanceUpdate u[]; };

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.arg0) {
        return;
    }
    VisViewRef view = VisViewRef(pc.view);
    const NphVisInstanceUpdate up = VisUpdatesRef(view.v.instance_updates).u[i];
    VisInstancesRef instances = VisInstancesRef(view.v.instances);
    VisTransformsRef prev = VisTransformsRef(view.v.prev_transforms);
    if (up.copy_previous != 0u) {
        prev.t[up.slot] = instances.i[up.slot].transform;
        instances.i[up.slot].flags &= ~uint(NPH_VIS_INSTANCE_MOVED);
        return;
    }
    NphVisInstance record = up.instance;
    const bool fresh = (record.flags & NPH_VIS_INSTANCE_FRESH) != 0u;
    const NphVisTransform before = fresh ? record.transform : instances.i[up.slot].transform;
    prev.t[up.slot] = before;
    const NphVisTransform now = record.transform;
    const bool moved = before.row0 != now.row0 || before.row1 != now.row1 ||
                       before.row2 != now.row2 || before.translation_low != now.translation_low;
    record.flags &= ~uint(NPH_VIS_INSTANCE_FRESH | NPH_VIS_INSTANCE_MOVED);
    record.flags |= moved ? uint(NPH_VIS_INSTANCE_MOVED) : 0u;
    instances.i[up.slot] = record;
}
