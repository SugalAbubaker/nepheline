// Writes value * index into a buffer reached through its device address.
#version 460
#include "nph_bindless.glsl"
#include "nph_shared.h"

layout(local_size_x = 64) in;

NPH_BUFFER_REF(OutBuffer) { uint data[]; };

layout(push_constant, scalar) uniform Push { NphTestPush pc; };

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    OutBuffer dst = OutBuffer(pc.buffer_address);
    dst.data[i] = pc.value * i;
}
