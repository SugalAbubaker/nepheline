// Writes value * index, doubled when k_double is set, plus k_offset and
// k_add: a pipeline's specialization constants decide what it computes
// (GpuFixture.specialization_constants_pick_the_variant).
#version 460
#include "nph_bindless.glsl"
#include "nph_shared.h"

layout(local_size_x = 64) in;

layout(constant_id = 0) const uint k_offset = 7u;
layout(constant_id = 1) const bool k_double = false;
layout(constant_id = 2) const float k_add = 1.0;

NPH_BUFFER_REF(OutBuffer) { uint data[]; };

layout(push_constant, scalar) uniform Push { NphTestPush pc; };

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    const uint v = pc.value * i;
    OutBuffer(pc.buffer_address).data[i] = (k_double ? 2u * v : v) + k_offset + uint(k_add);
}
