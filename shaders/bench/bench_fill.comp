// Write bandwidth: every invocation stores one uvec4 (16 bytes).
#version 460
#include "nph_bindless.glsl"
#include "nph_shared.h"

layout(local_size_x = 256) in;

NPH_BUFFER_REF(Words) { uvec4 v[]; };

layout(push_constant, scalar) uniform Push { NphBenchPush pc; };

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    Words dst = Words(pc.address);
    dst.v[i] = uvec4(i, i ^ 0x9E3779B9u, i * 3u, pc.iterations);
}
