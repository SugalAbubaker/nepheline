// FP32 throughput: eight independent FMA chains per invocation for
// `iterations` steps (8 * iterations * 2 FLOP per invocation), result
// written so the work survives.
#version 460
#include "nph_bindless.glsl"
#include "nph_shared.h"

layout(local_size_x = 256) in;

NPH_BUFFER_REF(Floats) { vec4 v[]; };

layout(push_constant, scalar) uniform Push { NphBenchPush pc; };

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    const float seed = float(i) * 1.0e-6 + 0.5;
    vec4 a = vec4(seed, seed + 0.1, seed + 0.2, seed + 0.3);
    vec4 b = vec4(seed + 0.4, seed + 0.5, seed + 0.6, seed + 0.7);
    const vec4 m = vec4(0.99999, 1.00001, 0.99998, 1.00002);
    const vec4 c = vec4(1.0e-7, -1.0e-7, 2.0e-7, -2.0e-7);
    for (uint k = 0u; k < pc.iterations; ++k) {
        a = fma(a, m, c);
        b = fma(b, m, c);
    }
    Floats dst = Floats(pc.address);
    dst.v[i] = a + b;
}
