// Read bandwidth: every invocation loads `iterations` uvec4 with a stride
// of one workgroup (coalesced), folds them, and the workgroup writes one
// uvec4 so the loads cannot be eliminated.
#version 460
#include "nph_bindless.glsl"
#include "nph_shared.h"

layout(local_size_x = 256) in;

NPH_BUFFER_REF(Words) { uvec4 v[]; };

layout(push_constant, scalar) uniform Push { NphBenchPush pc; };

shared uvec4 s_sum[256];

void main()
{
    Words src = Words(pc.address);
    Words dst = Words(pc.address2);
    uvec4 acc = uvec4(0u);
    const uint stride = gl_NumWorkGroups.x * 256u;
    for (uint k = 0u; k < pc.iterations; ++k) {
        const uint i = gl_GlobalInvocationID.x + k * stride;
        if (i < pc.count) {
            acc ^= src.v[i];
        }
    }
    s_sum[gl_LocalInvocationID.x] = acc;
    barrier();
    if (gl_LocalInvocationID.x == 0u) {
        uvec4 total = uvec4(0u);
        for (uint j = 0u; j < 256u; ++j) {
            total ^= s_sum[j];
        }
        dst.v[gl_WorkGroupID.x] = total;
    }
}
