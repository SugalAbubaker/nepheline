{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "win-msvc",
      "inherits": "windows-base",
      "displayName": "Windows / MSVC (cl)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "win-clang",
      "inherits": "windows-base",
      "displayName": "Windows / clang-cl",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "linux-gcc",
      "inherits": "linux-base",
      "displayName": "Linux / GCC",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang",
      "inherits": "linux-base",
      "displayName": "Linux / Clang",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-clang-tidy",
      "inherits": "linux-base",
      "generator": "Ninja",
      "displayName": "Linux / Clang, single-config Development (drives clang-tidy)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Development"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-msvc-debug",
      "configurePreset": "win-msvc",
      "configuration": "Debug"
    },
    {
      "name": "win-msvc-development",
      "configurePreset": "win-msvc",
      "configuration": "Development"
    },
    {
      "name": "win-msvc-profile",
      "configurePreset": "win-msvc",
      "configuration": "Profile"
    },
    {
      "name": "win-msvc-shipping",
      "configurePreset": "win-msvc",
      "configuration": "Shipping"
    },
    {
      "name": "win-clang-debug",
      "configurePreset": "win-clang",
      "configuration": "Debug"
    },
    {
      "name": "win-clang-development",
      "configurePreset": "win-clang",
      "configuration": "Development"
    },
    {
      "name": "win-clang-profile",
      "configurePreset": "win-clang",
      "configuration": "Profile"
    },
    {
      "name": "win-clang-shipping",
      "configurePreset": "win-clang",
      "configuration": "Shipping"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-development",
      "configurePreset": "linux-gcc",
      "configuration": "Development"
    },
    {
      "name": "linux-gcc-profile",
      "configurePreset": "linux-gcc",
      "configuration": "Profile"
    },
    {
      "name": "linux-gcc-shipping",
      "configurePreset": "linux-gcc",
      "configuration": "Shipping"
    },
    {
      "name": "linux-clang-debug",
      "configurePreset": "linux-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-clang-development",
      "configurePreset": "linux-clang",
      "configuration": "Development"
    },
    {
      "name": "linux-clang-profile",
      "configurePreset": "linux-clang",
      "configuration": "Profile"
    },
    {
      "name": "linux-clang-shipping",
      "configurePreset": "linux-clang",
      "configuration": "Shipping"
    },
    {
      "name": "linux-clang-tidy",
      "configurePreset": "linux-clang-tidy"
    }
  ],
  "testPresets": [
    {
      "name": "win-msvc-debug",
      "configurePreset": "win-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "win-msvc-development",
      "configurePreset": "win-msvc",
      "configuration": "Development",
      "output": {
